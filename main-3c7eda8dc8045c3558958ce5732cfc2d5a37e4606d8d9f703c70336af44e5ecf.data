ˆˆs‰Œð␀Lð␀L€AØ&1¤n°ZÔ&@À1Ñ&D€K„N5—<’< ‘?”?Ñ#Ø)4¬¸Ô)GÈ!Ñ)K€K„N8—?’? 1Ñ%Ô%Ñ&Ð&à	ˆˆr‰Œð␀Xñ␀X€AØ)4¬¸Ô)GÈ!Ñ)K€K„N8—?’? 1Ñ%Ô%Ñ&Ø)4¬¸Ô)GÈ!Ñ)K€K„N8—?’? 1Ñ%Ô%Ñ&Ø)4¬Ð8IÔ)JÈQÑ)N€K„N8—?’? 1Ñ%Ô%Ñ&Ø)4¬Ð8MÔ)NÐQRÑ)R€K„N8—?’? 1Ñ%Ô%Ñ&Ø*5¬.Ð9LÔ*MÐPQÑ*Q€K„N9×#Ò# AÑ&Ô&Ñ'Ø)4¬¸Ô)@ÀFÑ)KÈaÑ)O€K„N8—?’? 1Ñ%Ô%Ñ&Ø*5¬.Ð9RÔ*SÐVWÑ*W€K„N9×#Ò# AÑ&Ô&Ñ'Ñ'à	ˆˆr‰Œð␀_ð␀_€AØ+6¬>¸.Ô+IÈqÐTWÉiÐ\]ÑM]Ñ+^€K„N:×$Ò$ QÑ'Ô'Ñ(Ð(ð␀
ˆˆr‰Œð␀Hð␀H€AØ,7¬N¸7Ô,CÀaÑ,G€K„N;×%Ò% aÑ(Ô(Ñ)Ð)à”×%Ò%Ñ'Ô'ð␀$ð␀$I€Dˆ#Ø‡}‚}VÑÔð␀$ØÔ×Ò˜sÑ#Ô#Ð#øð$ð␀$rÂ␀␀from PyQt5.QtCore import QObject, Qt, pyqtSignal
from PyQt5.QtGui import QColor
from PyQt5.QtTest import QTest
from PyQt5.QtWidgets import QLineEdit

from editor.slider_targets import SliderTargetsEditor, NOTE_TEXT
from protocol.key_colours import LedInfo
from protocol.slider_targets import SliderTarget
from test.test_key_colours_editor import make_keys
from vial_device import VialKeyboard
from widgets.editor_container import EditorContainer

WHITE = (255, 255, 255)


class FakeKeyboard:

    def __init__(self, supported=True, targets=None, current=0, maximum=8):
        self.slider_supported = supported
        self.slider_max = maximum
        self.slider_name_max = 12
        self.slider_targets = list(targets or [SliderTarget(62, WHITE, "Slider")])
        self.slider_current = current
        self.calls = []
        self.fail = False
        self.next_current = None   # what the next reload reports

    def set_slider_targets(self, targets):
        targets = [SliderTarget(*t) for t in targets]
        self.calls.append(("set", targets))
        if self.fail:
            raise RuntimeError("boom")
        for t in targets:
            if len(t.name) > self.slider_name_max or any(ord(ch) > 127 for ch in t.name):
                raise ValueError("bad slider name")
        self.slider_targets = targets
        if self.slider_current >= len(targets):
            self.slider_current = 0

    def reload_slider_targets(self):
        self.calls.append(("reload",))
        saved = list(self.slider_targets)
        self.slider_supported = False
        self.slider_targets = []
        if self.fail:
            raise RuntimeError("boom")
        self.slider_targets = saved
        self.slider_supported = True
        if self.next_current is not None:
            self.slider_current = self.next_current


def make_device(kb):
    dev = VialKeyboard.__new__(VialKeyboard)
    dev.keyboard = kb
    return dev


all_containers = []


def make_editor(qtbot, kb=None):
    kb = kb or FakeKeyboard()
    editor = SliderTargetsEditor()
    container = EditorContainer(editor)
    qtbot.addWidget(container)
    all_containers.append(container)
    editor.rebuild(make_device(kb))
    container.show()
    return editor, kb


def three():
    return [SliderTarget(62, WHITE, "Music"), SliderTarget(63, (255, 0, 0), "Game"),
            SliderTarget(64, (0, 0, 255), "Chat")]


def sets(kb):
    return [c[1] for c in kb.calls if c[0] == "set"]


def test_hidden_when_unsupported(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(supported=False))
    assert not editor.valid()
    editor.rebuild(None)
    assert not editor.valid()


def test_rows_match_targets(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    assert editor.valid()
    assert [r.name.text() for r in editor.rows] == ["Music", "Game", "Chat"]
    assert [r.control.value() for r in editor.rows] == [62, 63, 64]
    assert [r.colour for r in editor.rows] == [WHITE, (255, 0, 0), (0, 0, 255)]
    assert editor.rows[0].name.maxLength() == 12
    assert editor.rows[0].control.minimum() == 0 and editor.rows[0].control.maximum() == 127
    assert editor.note.text() == NOTE_TEXT
    assert "Next slider target" in NOTE_TEXT
    assert "User tab" in NOTE_TEXT


def test_edit_name_writes_full_list(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    editor.rows[1].name.setText("Games")
    editor.rows[1].name.editingFinished.emit()
    assert sets(kb) == [[three()[0], SliderTarget(63, (255, 0, 0), "Games"), three()[2]]]
    # unchanged name: no write
    editor.rows[1].name.editingFinished.emit()
    assert len(sets(kb)) == 1


def test_edit_control_writes_full_list(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    editor.rows[2].control.setValue(70)
    assert sets(kb) == [three()[:2] + [SliderTarget(70, (0, 0, 255), "Chat")]]
    assert kb.slider_targets[2].control == 70


def test_edit_colour_writes_on_accept(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    editor.rows[0].swatch.clicked.emit()
    editor.dlg_color.setCurrentColor(QColor(1, 2, 3))
    editor.dlg_color.reject()
    assert sets(kb) == []
    editor.rows[0].swatch.clicked.emit()
    editor.dlg_color.setCurrentColor(QColor(1, 2, 3))
    editor.dlg_color.accept()
    assert sets(kb) == [[SliderTarget(62, (1, 2, 3), "Music")] + three()[1:]]
    assert editor.rows[0].colour == (1, 2, 3)


def test_add_target_defaults_and_max(qtbot):
    targets = [SliderTarget(62, WHITE, "A"), SliderTarget(64, WHITE, "B")]
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=targets, maximum=3))
    assert editor.btn_add.isEnabled()
    editor.btn_add.click()
    assert sets(kb) == [targets + [SliderTarget(63, WHITE, "Target 3")]]
    assert len(editor.rows) == 3
    assert not editor.btn_add.isEnabled()


def test_remove_disabled_with_one_target(qtbot):
    editor, kb = make_editor(qtbot)
    assert len(editor.rows) == 1
    assert not editor.rows[0].remove.isEnabled()


def test_remove_writes_list(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    editor.rows[1].remove.click()
    assert sets(kb) == [[three()[0], three()[2]]]
    assert [r.name.text() for r in editor.rows] == ["Music", "Chat"]


def test_up_down_reorder_writes(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    assert not editor.rows[0].up.isEnabled()
    assert not editor.rows[2].down.isEnabled()
    a, b, c = three()
    editor.rows[2].up.click()
    assert sets(kb)[-1] == [a, c, b]
    editor.rows[0].down.click()
    assert sets(kb)[-1] == [c, a, b]
    assert [r.name.text() for r in editor.rows] == ["Chat", "Music", "Game"]


def test_current_row_marked_and_updated_by_timer(qtbot):
    kb = FakeKeyboard(targets=three(), current=1)
    editor, kb = make_editor(qtbot, kb)
    assert [r.marker.text() for r in editor.rows] == ["", "â–¶", ""]
    assert editor.rows[1].name.font().bold()
    assert not editor.rows[0].name.font().bold()

    editor.activate()
    assert editor.timer.isActive()
    assert editor.timer.interval() == 1000
    kb.next_current = 2
    editor.rows[0].name.setText("typing")   # not yet written
    editor.on_timer()
    assert ("reload",) in kb.calls
    assert [r.marker.text() for r in editor.rows] == ["", "", "â–¶"]
    assert editor.rows[2].name.font().bold()
    # list didn't change, so the rows were not rebuilt under the user's typing
    assert editor.rows[0].name.text() == "typing"
    editor.deactivate()
    assert not editor.timer.isActive()


def test_errors_shown_no_crash(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    assert editor.error_label.isHidden()
    kb.fail = True
    editor.rows[0].control.setValue(10)
    assert not editor.error_label.isHidden()
    # table reflects the keyboard's (unchanged) state
    assert editor.rows[0].control.value() == 62
    editor.on_timer()
    assert not editor.error_label.isHidden()
    # a failed reload keeps the last known state
    assert editor.valid()
    assert kb.slider_targets == three()
    assert len(editor.rows) == 3
    kb.fail = False
    editor.rows[0].control.setValue(10)
    assert editor.error_label.isHidden()
    assert kb.slider_targets[0].control == 10


def test_bad_name_shows_error_and_reverts(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    editor.rows[0].name.setText("MÃ¼sic")
    editor.rows[0].name.editingFinished.emit()
    assert not editor.error_label.isHidden()
    assert editor.rows[0].name.text() == "Music"


def test_removed_row_does_not_write(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    old = editor.rows[2]
    editor.rows[1].remove.click()
    # a focused name field emits editingFinished when hidden; it must not write against the new list
    old.name.editingFinished.emit()
    old.control.setValue(100)
    assert sets(kb) == [[three()[0], three()[2]]]


def test_name_rejects_non_ascii(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    name = editor.rows[0].name
    name.clear()
    QTest.keyClicks(name, "MusÃ©e")
    assert name.text() == "Muse"
    assert all(32 <= ord(ch) <= 126 for ch in name.text())


# ---- lights that flash when switching target ----

RED, BLUE = (255, 0, 0), (0, 0, 255)
# three keys plus a side light on each side
LEDS = [LedInfo(i * 20, 0, 4, 0, i) for i in range(3)] + \
       [LedInfo(0, 32, 2, 0xFF, 0xFF), LedInfo(224, 32, 2, 0xFF, 0xFF)]


class FlashKeyboard(FakeKeyboard):

    def __init__(self, mask=0b10101, leds=LEDS, **kw):
        kw.setdefault("targets", three())
        super().__init__(**kw)
        self.slider_flash_supported = True
        self.slider_flash_mask = mask
        self.keys = make_keys()
        self.leds = list(leds)
        self.next_flash = None

    def set_slider_flash_mask(self, mask):
        self.calls.append(("flash", mask))
        if self.fail:
            raise RuntimeError("boom")
        self.slider_flash_mask = mask

    def reload_slider_targets(self):
        saved = self.slider_flash_mask
        self.slider_flash_supported = False
        super().reload_slider_targets()
        self.slider_flash_supported = True
        self.slider_flash_mask = saved if self.next_flash is None else self.next_flash


class FakeLayoutEditor(QObject):
    changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.choice = 0

    def get_choice(self, idx):
        return self.choice


def make_flash_editor(qtbot, kb=None, layout_editor=None):
    kb = kb or FlashKeyboard()
    editor = SliderTargetsEditor(layout_editor)
    container = EditorContainer(editor)
    qtbot.addWidget(container)
    all_containers.append(container)
    editor.rebuild(make_device(kb))
    container.show()
    return editor, kb


def flashes(kb):
    return [c[1] for c in kb.calls if c[0] == "flash"]


def stroke(editor, *leds):
    for led in leds:
        editor.flash_widget.stroke_painted.emit([led])
    editor.flash_widget.stroke_finished.emit()


def test_flash_hidden_on_version_1_firmware(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(targets=three()))
    assert editor.flash_section.isHidden()
    editor.rows[0].control.setValue(10)
    assert sets(kb)[-1][0].control == 10


def test_flash_hidden_without_led_info(qtbot):
    editor, kb = make_flash_editor(qtbot, FlashKeyboard(leds=[]))
    assert editor.flash_section.isHidden()


def test_flash_shows_mask_in_current_colour(qtbot):
    editor, kb = make_flash_editor(qtbot)
    assert not editor.flash_section.isHidden()
    assert editor.flash_widget.leds == LEDS
    assert editor.flash_widget.colours == [WHITE, None, WHITE, None, WHITE]
    editor2, kb2 = make_flash_editor(qtbot, FlashKeyboard(current=1))
    assert editor2.flash_widget.colours == [RED, None, RED, None, RED]


def test_clicking_row_previews_its_colour(qtbot):
    editor, kb = make_flash_editor(qtbot)
    QTest.mouseClick(editor.rows[2].name, Qt.LeftButton)
    assert editor.flash_widget.colours == [BLUE, None, BLUE, None, BLUE]
    QTest.mouseClick(editor.rows[1].marker, Qt.LeftButton)
    assert editor.flash_widget.colours == [RED, None, RED, None, RED]
    QTest.mouseClick(editor.rows[0].control.findChild(QLineEdit), Qt.LeftButton)
    assert editor.flash_widget.colours == [WHITE, None, WHITE, None, WHITE]
    # previewing does not touch the keyboard
    assert sets(kb) == [] and flashes(kb) == []
    assert kb.slider_current == 0


def test_stroke_first_led_turns_on_and_writes_once(qtbot):
    editor, kb = make_flash_editor(qtbot)
    editor.flash_widget.stroke_painted.emit([1])   # off -> the stroke turns lights on
    editor.flash_widget.stroke_painted.emit([0])   # already on: stays on
    editor.flash_widget.stroke_painted.emit([3])
    assert flashes(kb) == []
    assert editor.flash_widget.colours == [WHITE] * 5
    editor.flash_widget.stroke_finished.emit()
    assert flashes(kb) == [0b11111]


def test_stroke_first_led_turns_off(qtbot):
    editor, kb = make_flash_editor(qtbot)
    stroke(editor, 0, 1, 2)
    assert flashes(kb) == [0b10000]
    assert editor.flash_widget.colours == [None, None, None, None, WHITE]


def test_empty_stroke_writes_nothing(qtbot):
    editor, kb = make_flash_editor(qtbot)
    editor.flash_widget.stroke_finished.emit()
    assert flashes(kb) == []


def test_flash_buttons(qtbot):
    editor, kb = make_flash_editor(qtbot)
    editor.btn_flash_none.click()
    assert flashes(kb) == [0]
    assert editor.flash_widget.colours == [None] * 5
    editor.btn_flash_edges.click()
    assert flashes(kb) == [0, 0b11000]
    editor.btn_flash_all.click()
    assert flashes(kb) == [0, 0b11000, 0b11111]
    assert editor.flash_widget.colours == [WHITE] * 5


def test_failed_flash_write_shows_error_and_keyboard_mask(qtbot):
    editor, kb = make_flash_editor(qtbot)
    kb.fail = True
    stroke(editor, 1, 3)
    assert flashes(kb) == [0b11111]
    assert not editor.error_label.isHidden()
    assert editor.flash_widget.colours == [WHITE, None, WHITE, None, WHITE]
    kb.fail = False
    editor.btn_flash_none.click()
    assert editor.error_label.isHidden()


def test_timer_only_redraws_on_change(qtbot):
    editor, kb = make_flash_editor(qtbot)
    builds, recolours = [], []
    orig_set_keyboard, orig_set_colours = editor.flash_widget.set_keyboard, editor.flash_widget.set_colours
    editor.flash_widget.set_keyboard = lambda *a: (builds.append(1), orig_set_keyboard(*a))
    editor.flash_widget.set_colours = lambda c: (recolours.append(list(c)), orig_set_colours(c))
    editor.on_timer()
    editor.on_timer()
    assert builds == [] and recolours == [] and flashes(kb) == []
    kb.next_flash = 0b00001
    editor.on_timer()
    assert recolours == [[WHITE, None, None, None, None]]
    assert builds == [] and flashes(kb) == []
    kb.next_current = 2
    editor.on_timer()
    assert recolours[-1] == [BLUE, None, None, None, None]
    assert builds == [] and flashes(kb) == []


def test_timer_mid_stroke_keeps_pending_drawing(qtbot):
    editor, kb = make_flash_editor(qtbot)
    editor.flash_widget.stroke_painted.emit([1])
    editor.on_timer()
    assert editor.flash_widget.colours == [WHITE, WHITE, WHITE, None, WHITE]
    editor.flash_widget.stroke_finished.emit()
    assert flashes(kb) == [0b10111]


def test_layout_choice_redraws(qtbot):
    layout = FakeLayoutEditor()
    editor, kb = make_flash_editor(qtbot, layout_editor=layout)
    assert editor.flash_widget.layout_choice == layout.get_choice
    builds = []
    orig = editor.flash_widget.set_keyboard
    editor.flash_widget.set_keyboard = lambda *a: (builds.append(a), orig(*a))
    layout.changed.emit()
    assert len(builds) == 1
    assert flashes(kb) == []
from kle_serial import Serial as KleSerial
from editor.key_colours import KeyColoursEditor, SWATCHES, BANNER_TEXT
from editor.layout_editor import LayoutEditor
from protocol.key_colours import LedInfo
from vial_device import VialKeyboard
from widgets.editor_container import EditorContainer

ORANGE = (0xff, 0x42, 0x00)


def make_keys():
    keys = []
    for key in KleSerial().deserialize([["0,0", "0,1", "0,2"]]).keys:
        row, col = key.labels[0].split(",")
        key.row, key.col = int(row), int(col)
        key.encoder_idx = key.encoder_dir = None
        key.layout_index = key.layout_option = -1
        keys.append(key)
    return keys


class FakeKeyboard:

    def __init__(self, supported=True, initialised=True, layers=2, leds=3):
        self.key_colours_supported = supported
        self.key_colours_layers = layers
        self.key_colours_led_count = leds
        self.key_colours_initialised = initialised
        self.key_colours = [[None] * leds for _ in range(layers)]
        self.leds = [LedInfo(i * 20, 0, 4, 0, i) for i in range(leds)]
        self.keys = make_keys()
        self.calls = []
        self.fail = False

    def set_key_colours(self, layer, changes):
        self.calls.append(("set", layer, dict(changes)))
        if self.fail:
            raise RuntimeError("boom")
        for led, c in changes.items():
            self.key_colours[layer][led] = c
        self.key_colours_initialised = True

    def set_key_colours_preview(self, layer):
        self.calls.append(("preview", layer))
        if self.fail:
            raise RuntimeError("boom")


def make_device(kb):
    dev = VialKeyboard.__new__(VialKeyboard)
    dev.keyboard = kb
    return dev


# pytest-qt only keeps weak references, so hold the containers for the whole session
all_containers = []


def make_editor(qtbot, kb=None):
    kb = kb or FakeKeyboard()
    editor = KeyColoursEditor(LayoutEditor())
    container = EditorContainer(editor)
    qtbot.addWidget(container)
    all_containers.append(container)
    editor.rebuild(make_device(kb))
    container.show()
    return editor, kb


def stroke(editor, *batches):
    for leds in batches:
        editor.widget.stroke_painted.emit(list(leds))
    editor.widget.stroke_finished.emit()


def sets(kb):
    return [c for c in kb.calls if c[0] == "set"]


def test_hidden_when_unsupported(qtbot):
    editor, kb = make_editor(qtbot, FakeKeyboard(supported=False))
    assert not editor.valid()
    editor.rebuild(None)
    assert not editor.valid()


def test_valid_when_supported(qtbot):
    editor, kb = make_editor(qtbot)
    assert editor.valid()
    assert [b.text() for b in editor.layer_buttons] == ["Layer 0", "Layer 1"]


def test_swatches():
    assert [s[0] for s in SWATCHES] == ["Orange", "Pink", "Purple", "Ice blue", "Green", "Red", "Yellow",
                                         "White", "Off"]
    assert SWATCHES[0][1] == "#ff4200" and SWATCHES[-1][1] == "#000000"


def test_brush_stroke_sends_each_led_and_undoes(qtbot):
    editor, kb = make_editor(qtbot)
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0], [1])
    assert sets(kb) == [("set", 0, {0: ORANGE}), ("set", 0, {1: ORANGE})]
    assert editor.widget.colours == [ORANGE, ORANGE, None]
    assert editor.history.can_undo()
    assert editor.btn_undo.isEnabled()

    editor.on_undo()
    assert sets(kb)[-1] == ("set", 0, {0: None, 1: None})
    assert kb.key_colours[0] == [None, None, None]
    assert editor.widget.colours == [None, None, None]
    assert not editor.history.can_undo()
    assert not editor.btn_undo.isEnabled()


def test_eraser_sends_none(qtbot):
    kb = FakeKeyboard()
    kb.key_colours[0][2] = ORANGE
    editor, kb = make_editor(qtbot, kb)
    editor.set_tool("eraser")
    stroke(editor, [2])
    assert sets(kb) == [("set", 0, {2: None})]


def test_fill_sends_all_leds_once(qtbot):
    editor, kb = make_editor(qtbot)
    editor.set_brush_colour(ORANGE)
    editor.set_tool("fill")
    stroke(editor, [1], [2])
    assert sets(kb) == [("set", 0, {0: ORANGE, 1: ORANGE, 2: ORANGE})]
    editor.on_undo()
    assert sets(kb)[-1] == ("set", 0, {0: None, 1: None, 2: None})


def test_undo_writes_old_colours_on_its_layer(qtbot):
    kb = FakeKeyboard()
    kb.key_colours[1][0] = (1, 2, 3)
    editor, kb = make_editor(qtbot, kb)
    editor.set_layer(1)
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0])
    editor.set_layer(0)
    editor.on_undo()
    assert sets(kb)[-1] == ("set", 1, {0: (1, 2, 3)})
    assert editor.layer == 1
    assert editor.layer_buttons[1].isChecked()
    # the undo itself is not recorded as a new stroke
    assert not editor.history.can_undo()


def test_activate_previews_and_deactivate_clears(qtbot):
    editor, kb = make_editor(qtbot)
    editor.activate()
    assert kb.calls[-1] == ("preview", 0)
    assert editor.preview_timer.isActive()
    assert editor.preview_timer.interval() == 1000
    editor.set_layer(1)
    assert kb.calls[-1] == ("preview", 1)
    editor.on_preview_timer()
    assert kb.calls[-1] == ("preview", 1)
    editor.deactivate()
    assert kb.calls[-1] == ("preview", None)
    assert not editor.preview_timer.isActive()


def test_layer_change_while_inactive_sends_no_preview(qtbot):
    editor, kb = make_editor(qtbot)
    editor.set_layer(1)
    assert [c for c in kb.calls if c[0] == "preview"] == []


def test_banner_only_when_uninitialised(qtbot):
    editor, kb = make_editor(qtbot)
    assert editor.banner.isHidden()
    editor, kb = make_editor(qtbot, FakeKeyboard(initialised=False))
    assert not editor.banner.isHidden()
    assert editor.banner_label.text() == BANNER_TEXT
    loads = []
    editor.load_requested.connect(lambda: loads.append(1))
    editor.btn_banner_load.click()
    assert loads == [1]
    # painting sets initialised, so the banner goes away
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0])
    assert editor.banner.isHidden()


def test_save_load_buttons_emit(qtbot):
    editor, kb = make_editor(qtbot)
    got = []
    editor.save_requested.connect(lambda: got.append("save"))
    editor.load_requested.connect(lambda: got.append("load"))
    editor.btn_save.click()
    editor.btn_load.click()
    assert got == ["save", "load"]
    assert editor.btn_save.text() == "Save backupâ€¦"
    assert editor.btn_load.text() == "Load backupâ€¦"


def test_keyboard_errors_show_inline(qtbot):
    editor, kb = make_editor(qtbot)
    assert editor.error_label.isHidden()
    kb.fail = True
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0])
    assert not editor.error_label.isHidden()
    editor.activate()
    editor.on_preview_timer()
    editor.deactivate()
    kb.fail = False
    stroke(editor, [1])
    assert editor.error_label.isHidden()


def test_lost_release_does_not_merge_strokes_or_block_undo(qtbot):
    from PyQt5.QtCore import Qt
    from PyQt5.QtTest import QTest
    editor, kb = make_editor(qtbot)
    w = editor.widget
    w.resize(w.sizeHint())
    editor.set_brush_colour(ORANGE)
    pos = [w._key_widgets[i].polygon.boundingRect().center().toPoint() for i in range(3)]
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, pos[0])
    # release lost; the next press must close the first stroke
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, pos[1])
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, pos[1])
    assert not editor.in_stroke
    editor.on_undo()
    assert sets(kb)[-1] == ("set", 0, {1: None})
    editor.on_undo()
    assert sets(kb)[-1] == ("set", 0, {0: None})


def test_write_error_survives_preview_ticks(qtbot):
    editor, kb = make_editor(qtbot)
    editor.activate()
    kb.fail = True
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0])
    assert not editor.error_label.isHidden()
    kb.fail = False
    editor.on_preview_timer()
    editor.set_layer(1)
    assert kb.calls[-1] == ("preview", 1)
    assert not editor.error_label.isHidden()
    stroke(editor, [1])
    assert editor.error_label.isHidden()
    # a preview error alone is cleared by the next good preview
    kb.fail = True
    editor.on_preview_timer()
    assert not editor.error_label.isHidden()
    kb.fail = False
    editor.on_preview_timer()
    assert editor.error_label.isHidden()
    editor.deactivate()


def test_undo_error_survives_preview_ticks(qtbot):
    editor, kb = make_editor(qtbot)
    editor.set_brush_colour(ORANGE)
    stroke(editor, [0])
    editor.activate()
    kb.fail = True
    editor.on_undo()
    assert not editor.error_label.isHidden()
    kb.fail = False
    editor.on_preview_timer()
    assert not editor.error_label.isHidden()
    editor.deactivate()
import unittest
import lzma
import struct

from keycodes.keycodes import Keycode
from protocol.keyboard_comm import Keyboard
from util import chunks, MSG_LEN

LAYOUT_2x2 = """
{"name":"test","vendorId":"0x0000","productId":"0x1111","lighting":"none","matrix":{"rows":2,"cols":2},"layouts":{"keymap":[["0,0","0,1"],["1,0","1,1"]]}}
"""

LAYOUT_ENCODER = r"""
{"name":"test","vendorId":"0x0000","productId":"0x1111","lighting":"none","matrix":{"rows":1,"cols":1},"layouts":{"keymap":[["0,0\n\n\n\n\n\n\n\n\ne","0,1\n\n\n\n\n\n\n\n\ne"],["0,0"]]}}
"""


def s(kc):
    return Keycode.serialize(kc)


class SimulatedDevice:

    def __init__(self):
        # sequence of keyboard communications, pairs of (request, response)
        self.expect_data = []
        # current index in communications
        self.expect_idx = 0

    def expect(self, inp, out):
        if isinstance(inp, str):
            inp = bytes.fromhex(inp)
        if isinstance(out, str):
            out = bytes.fromhex(out)
        out += b"\x00" * (MSG_LEN - len(out))
        self.expect_data.append((inp, out))

    def expect_via_protocol(self, via_protocol):
        self.expect("01", struct.pack(">BH", 1, via_protocol))

    def expect_keyboard_id(self, kbid):
        self.expect("FE00", struct.pack("<IQ", 0, kbid))

    def expect_layout(self, layout):
        compressed = lzma.compress(layout.encode("utf-8"))
        self.expect("FE01", struct.pack("<I", len(compressed)))
        for idx, chunk in enumerate(chunks(compressed, 32)):
            self.expect(
                struct.pack("<BBI", 0xFE, 0x02, idx),
                chunk
            )

    def expect_layers(self, layers):
        self.expect("11", struct.pack("BB", 0x11, layers))

    def expect_keymap(self, keymap):
        buffer = b""
        for layer in keymap:
            for row in layer:
                for col in row:
                    buffer += struct.pack(">H", col)
        # client will retrieve our keymap buffer in chunks of 28 bytes
        for x, chunk in enumerate(chunks(buffer, 28)):
            query = struct.pack(">BHB", 0x12, x, len(chunk))
            self.expect(query, query + chunk)

    def expect_encoders(self, encoders):
        for l, layer in enumerate(encoders):
            for e, enc in enumerate(layer):
                self.expect(struct.pack("BBBB", 0xFE, 3, l, e), struct.pack(">HH", enc[0], enc[1]))

    @staticmethod
    def sim_send(dev, data, retries=1):
        if dev.expect_idx >= len(dev.expect_data):
            raise Exception("Trying to communicate more times ({}) than expected ({}); got data={}".format(
                dev.expect_idx + 1,
                len(dev.expect_data),
                data.hex()
            ))
        inp, out = dev.expect_data[dev.expect_idx]
        if data != inp:
            raise Exception("Got unexpected data at index {}: expected={} with result={} got={}".format(
                dev.expect_idx,
                inp.hex(),
                out.hex(),
                data.hex()
            ))
        dev.expect_idx += 1
        return out

    def finish(self):
        if self.expect_idx != len(self.expect_data):
            raise Exception("Didn't communicate all the way, remaining data = {}".format(
                self.expect_data[self.expect_idx:]
            ))


class TestKeyboard(unittest.TestCase):

    @staticmethod
    def prepare_keyboard(layout, keymap, encoders=None):
        dev = SimulatedDevice()
        dev.expect_via_protocol(9)
        dev.expect_keyboard_id(0)
        dev.expect_layout(layout)
        dev.expect_layers(len(keymap))

        # macro count
        dev.expect("0C", "0C00")
        # macro buffer size
        dev.expect("0D", "0D0000")

        dev.expect_keymap(keymap)
        if encoders is not None:
            dev.expect_encoders(encoders)

        kb = Keyboard(dev, dev.sim_send)
        kb.reload()

        return kb, dev

    def test_keyboard_layout(self):
        """ Tests that loading a layout from a keyboard works """

        kb, dev = self.prepare_keyboard(LAYOUT_2x2, [[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        self.assertEqual(kb.layers, 2)
        self.assertEqual(kb.layout[(0, 0, 0)], s(1))
        self.assertEqual(kb.layout[(0, 0, 1)], s(2))
        self.assertEqual(kb.layout[(0, 1, 0)], s(3))
        self.assertEqual(kb.layout[(0, 1, 1)], s(4))
        self.assertEqual(kb.layout[(1, 0, 0)], s(5))
        self.assertEqual(kb.layout[(1, 0, 1)], s(6))
        self.assertEqual(kb.layout[(1, 1, 0)], s(7))
        self.assertEqual(kb.layout[(1, 1, 1)], s(8))
        dev.finish()

    def test_set_key(self):
        """ Tests that setting a key works """

        kb, dev = self.prepare_keyboard(LAYOUT_2x2, [[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        dev.expect("050101000009", "")
        kb.set_key(1, 1, 0, 9)
        self.assertEqual(kb.layout[(1, 1, 0)], 9)

        dev.finish()

    def test_set_key_twice(self):
        """ Tests that setting a key twice is optimized (doesn't send 2 cmds) """

        kb, dev = self.prepare_keyboard(LAYOUT_2x2, [[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        dev.expect("050101000009", "")
        kb.set_key(1, 1, 0, 9)
        kb.set_key(1, 1, 0, 9)
        self.assertEqual(kb.layout[(1, 1, 0)], 9)

        dev.finish()

    def test_layout_save_restore(self):
        """ Tests that layout saving and restore works """

        kb, dev = self.prepare_keyboard(LAYOUT_2x2, [[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        dev.expect("05010100000A", "")
        kb.set_key(1, 1, 0, Keycode.serialize(10))
        self.assertEqual(kb.layout[(1, 1, 0)], Keycode.serialize(10))
        data = kb.save_layout()
        dev.finish()

        kb, dev = self.prepare_keyboard(LAYOUT_2x2, [[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        dev.expect("05010100000A", "")
        kb.restore_layout(data)
        self.assertEqual(kb.layout[(1, 1, 0)], Keycode.serialize(10))
        dev.finish()

    def test_encoder_simple(self):
        """ Tests that we try to retrieve encoder layout """

        kb, dev = self.prepare_keyboard(LAYOUT_ENCODER, [[[1]], [[2]], [[3]], [[4]]], [[(10, 11)], [(12, 13)], [(14, 15)], [(16, 17)]])
        self.assertEqual(kb.encoder_layout[(0, 0, 0)], Keycode.serialize(10))
        self.assertEqual(kb.encoder_layout[(0, 0, 1)], Keycode.serialize(11))
        self.assertEqual(kb.encoder_layout[(1, 0, 0)], Keycode.serialize(12))
        self.assertEqual(kb.encoder_layout[(1, 0, 1)], Keycode.serialize(13))
        self.assertEqual(kb.encoder_layout[(2, 0, 0)], Keycode.serialize(14))
        self.assertEqual(kb.encoder_layout[(2, 0, 1)], Keycode.serialize(15))
        self.assertEqual(kb.encoder_layout[(3, 0, 0)], Keycode.serialize(16))
        self.assertEqual(kb.encoder_layout[(3, 0, 1)], Keycode.serialize(17))
        dev.finish()

    def test_encoder_change(self):
        """ Test that changing encoder works """

        kb, dev = self.prepare_keyboard(LAYOUT_ENCODER, [[[1]], [[2]], [[3]], [[4]]], [[(10, 11)], [(12, 13)], [(14, 15)], [(16, 17)]])
        self.assertEqual(kb.encoder_layout[(1, 0, 0)], Keycode.serialize(12))
        self.assertEqual(kb.encoder_layout[(1, 0, 1)], Keycode.serialize(13))
        dev.expect("FE040100010020", "")
        kb.set_encoder(1, 0, 1, Keycode.serialize(0x20))
        self.assertEqual(kb.encoder_layout[(1, 0, 1)], Keycode.serialize(0x20))
from PyQt5.QtCore import Qt, QPoint, QPointF
from PyQt5.QtGui import QMouseEvent
from PyQt5.QtCore import QEvent
from PyQt5.QtTest import QTest
from PyQt5.QtWidgets import QApplication

from kle_serial import Serial as KleSerial
from protocol.key_colours import LedInfo
from widgets.colour_keyboard_widget import ColourKeyboardWidget, DOT_RADIUS, DOT_HIT_RADIUS


def make_keys():
    keys = []
    for key in KleSerial().deserialize([["0,0", "0,1", "0,2"]]).keys:
        row, col = key.labels[0].split(",")
        key.row, key.col = int(row), int(col)
        key.encoder_idx = key.encoder_dir = None
        key.layout_index = key.layout_option = -1
        keys.append(key)
    return keys


def make_widget(qtbot):
    w = ColourKeyboardWidget()
    qtbot.addWidget(w)
    w.set_keyboard(make_keys(), [LedInfo(i * 20, 0, 4, 0, i) for i in range(3)])
    w.set_colours([(255, 0, 0), None, (0, 0, 255)])
    w.resize(w.sizeHint())
    w.show()
    return w


def move(w, pos):
    QApplication.sendEvent(w, QMouseEvent(QEvent.MouseMove, QPointF(pos), Qt.NoButton, Qt.LeftButton, Qt.NoModifier))


def centre(w, i):
    return w._key_widgets[i].polygon.boundingRect().center().toPoint()


def test_stroke_paints_each_led_once(qtbot):
    w = make_widget(qtbot)
    painted, finished = [], []
    w.stroke_painted.connect(painted.extend)
    w.stroke_finished.connect(lambda: finished.append(1))

    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    for i in (1, 2, 1, 0):
        move(w, centre(w, i))
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, QPoint(-50, -50))
    assert painted == [0, 1, 2]
    assert finished == [1]

    del painted[:]
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    assert painted == [0]
    assert finished == [1, 1]


def test_move_without_press_paints_nothing(qtbot):
    w = make_widget(qtbot)
    painted = []
    w.stroke_painted.connect(painted.extend)
    move(w, centre(w, 1))
    assert painted == []


def test_renders(qtbot):
    w = make_widget(qtbot)
    assert not w.grab().isNull()


def test_layout_choice_selects_option(qtbot):
    keys = []
    kle = [["0,0\n\n\n0,0"], [{"x": 3}, "0,1\n\n\n0,1"]]
    for key in KleSerial().deserialize(kle).keys:
        row, col = key.labels[0].split(",")
        key.row, key.col = int(row), int(col)
        idx, opt = key.labels[8].split(",")
        key.layout_index, key.layout_option = int(idx), int(opt)
        keys.append(key)
    leds = [LedInfo(0, 0, 4, 0, 0), LedInfo(10, 0, 4, 0, 1)]
    for choice, expected in ((0, [0]), (1, [1])):
        w = ColourKeyboardWidget()
        qtbot.addWidget(w)
        w.set_keyboard(keys, leds, lambda idx, c=choice: c)
        w.resize(w.sizeHint())
        painted = []
        w.stroke_painted.connect(painted.extend)
        assert len(w._key_widgets) == 1
        # the chosen alternative is shifted to the same place
        assert w._key_widgets[0].polygon.boundingRect().topLeft().x() == w.padding
        pos = w._key_widgets[0].polygon.boundingRect().center().toPoint()
        QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, pos)
        QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, pos)
        assert painted == expected


def test_edge_led_dot_paintable(qtbot):
    w = ColourKeyboardWidget()
    qtbot.addWidget(w)
    leds = [LedInfo(i * 20, 0, 4, 0, i) for i in range(3)] + [LedInfo(112, 32, 2, 0xFF, 0xFF)]
    w.set_keyboard(make_keys(), leds)
    w.resize(w.sizeHint())
    painted = []
    w.stroke_painted.connect(painted.extend)
    pos = w._dots[0][1].toPoint()
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, pos)
    move(w, pos + QPoint(1, 1))
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, pos)
    assert painted == [3]


def test_edge_led_dots_sit_outside_the_keys(qtbot):
    # side strips like the GMMK Numpad's: x = 0 (left) and x = 224 (right), full height
    w = ColourKeyboardWidget()
    qtbot.addWidget(w)
    leds = [LedInfo(i * 20, 0, 4, 0, i) for i in range(3)]
    leds += [LedInfo(0, y, 2, 0xFF, 0xFF) for y in (0, 32, 64)]
    leds += [LedInfo(224, y, 2, 0xFF, 0xFF) for y in (0, 32, 64)]
    w.set_keyboard(make_keys(), leds)
    keys = w._key_widgets[0].polygon.boundingRect()
    for k in w._key_widgets[1:]:
        keys = keys.united(k.polygon.boundingRect())
    gap = DOT_RADIUS * 2
    dots = dict(w._dots)
    for led in (3, 4, 5):
        assert dots[led].x() <= keys.left() - gap
    for led in (6, 7, 8):
        assert dots[led].x() >= keys.right() + gap
    # side strips span the keys' height rather than sticking out above and below
    for led in (3, 4, 5, 6, 7, 8):
        assert keys.top() <= dots[led].y() <= keys.bottom()
    size = w.sizeHint()
    for p in dots.values():
        assert DOT_RADIUS <= p.x() <= size.width() - DOT_RADIUS
        assert DOT_RADIUS <= p.y() <= size.height() - DOT_RADIUS


def test_no_edge_leds_no_extra_margin(qtbot):
    w = make_widget(qtbot)
    keys = w._key_widgets[0].polygon.boundingRect()
    assert keys.left() == w.padding


def test_fast_drag_paints_every_key_crossed(qtbot):
    w = make_widget(qtbot)
    painted = []
    w.stroke_painted.connect(painted.extend)
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    # one move event that jumps straight across key 1
    move(w, centre(w, 2))
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, centre(w, 2))
    assert painted == [0, 1, 2]


def test_move_without_button_finishes_lost_stroke(qtbot):
    w = make_widget(qtbot)
    painted, finished = [], []
    w.stroke_painted.connect(painted.extend)
    w.stroke_finished.connect(lambda: finished.append(1))
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    # the release went elsewhere; the next move has no button held
    QApplication.sendEvent(w, QMouseEvent(QEvent.MouseMove, QPointF(centre(w, 1)), Qt.NoButton, Qt.NoButton,
                                          Qt.NoModifier))
    assert painted == [0]
    assert finished == [1]
    move(w, centre(w, 2))
    assert painted == [0]


def test_press_finishes_lost_stroke_first(qtbot):
    w = make_widget(qtbot)
    events = []
    w.stroke_painted.connect(lambda leds: events.append(("paint", leds)))
    w.stroke_finished.connect(lambda: events.append("finish"))
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 0))
    # release lost, then a new press
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, centre(w, 1))
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, centre(w, 1))
    assert events == [("paint", [0]), "finish", ("paint", [1]), "finish"]


def side_widget(qtbot):
    w = ColourKeyboardWidget()
    qtbot.addWidget(w)
    leds = [LedInfo(i * 20, 0, 4, 0, i) for i in range(3)]
    leds += [LedInfo(0, y, 2, 0xFF, 0xFF) for y in (0, 32, 64)]
    w.set_keyboard(make_keys(), leds)
    w.resize(w.sizeHint())
    w.show()
    return w


def test_bigger_side_light_dots_stay_outside_keys(qtbot):
    assert DOT_RADIUS >= 7
    assert DOT_HIT_RADIUS >= DOT_RADIUS + 4
    w = side_widget(qtbot)
    keys = w._key_widgets[0].polygon.boundingRect()
    for _, p in w._dots:
        # the whole circle sits clear of the keys
        assert p.x() + DOT_RADIUS < keys.left()


def test_dot_hit_area_covers_the_circle(qtbot):
    w = side_widget(qtbot)
    painted = []
    w.stroke_painted.connect(painted.extend)
    pos = w._dots[1][1]
    # click the circle's top edge, not its centre
    edge = QPointF(pos.x(), pos.y() - DOT_RADIUS + 1).toPoint()
    QTest.mousePress(w, Qt.LeftButton, Qt.NoModifier, edge)
    QTest.mouseRelease(w, Qt.LeftButton, Qt.NoModifier, edge)
    assert painted == [4]
import lzma
import os.path
import struct

from PyQt5.QtCore import QPoint
from PyQt5.QtWidgets import QPushButton
from pytestqt.qt_compat import qt_api

from main_window import MainWindow

from protocol.constants import CMD_VIA_GET_PROTOCOL_VERSION, CMD_VIA_VIAL_PREFIX, CMD_VIAL_GET_KEYBOARD_ID, \
    CMD_VIAL_GET_SIZE, CMD_VIAL_GET_DEFINITION, CMD_VIA_GET_LAYER_COUNT, CMD_VIA_MACRO_GET_COUNT, \
    CMD_VIA_MACRO_GET_BUFFER_SIZE, CMD_VIAL_QMK_SETTINGS_QUERY, CMD_VIAL_DYNAMIC_ENTRY_OP, \
    DYNAMIC_VIAL_GET_NUMBER_OF_ENTRIES, CMD_VIA_KEYMAP_GET_BUFFER, CMD_VIA_MACRO_GET_BUFFER, CMD_VIAL_GET_UNLOCK_STATUS, \
    CMD_VIA_SET_KEYCODE, DYNAMIC_VIAL_COMBO_GET, DYNAMIC_VIAL_COMBO_SET, DYNAMIC_VIAL_TAP_DANCE_GET, \
    DYNAMIC_VIAL_TAP_DANCE_SET
from widgets.square_button import SquareButton

FAKE_KEYBOARD = """
{
  "matrix": {
    "rows": 2,
    "cols": 2
  },
  "layouts": {
    "keymap": [
      [
        "0,0",
        "0,1"
      ],
      [
        "1,0",
        "1,1"
      ]
    ]
  }
}
"""


def mock_enumerate():
    return [{
        "vendor_id": 0xDEAD,
        "product_id": 0xBEEF,
        "serial_number": "vial:f64c2b3c",
        "usage_page": 0xFF60,
        "usage": 0x61,
        "path": "/magic/path/for/tests",
        "manufacturer_string": "Vial Testing Ltd",
        "product_string": "Test Keyboard",
    }]


class VirtualKeyboard:

    def __init__(self, kbjson, combos=None, tap_dance=None):
        if combos is None:
            combos = []
        if tap_dance is None:
            tap_dance = []

        self.keyboard_definition = lzma.compress(kbjson.encode("utf-8"))

        self.rows = 2
        self.cols = 2
        self.layers = 4
        self.keymap = []
        for layer in range(self.layers):
            self.keymap.append([])
            for row in range(self.rows):
                self.keymap[-1].append([0 for x in range(self.cols)])

        self.macro_count = 8
        self.macro_buffer = b"\x00" * 512

        self.combos = combos
        self.tap_dance = tap_dance

        self.key_override_entries = 0
        self.alt_repeat_key_entries = 0

    def get_keymap_buffer(self):
        output = b""
        for layer in range(self.layers):
            for row in range(self.rows):
                for col in range(self.cols):
                    output += struct.pack(">H", self.keymap[layer][row][col])
        return output

    def vial_cmd_dynamic(self, msg):
        if msg[2] == DYNAMIC_VIAL_GET_NUMBER_OF_ENTRIES:
            response = struct.pack("BBBB", len(self.tap_dance), len(self.combos),
                                   self.key_override_entries, self.alt_repeat_key_entries)
            # Zero pad to 31 bytes.
            response += (31 - len(response)) * b'\0'
            # Set last two bits, indicating Caps Word and Layer Lock.
            response += (0b00000011).to_bytes(1, "little")
            return response
        elif msg[2] == DYNAMIC_VIAL_COMBO_GET:
            idx = msg[3]
            assert idx < len(self.combos)
            return struct.pack("<BHHHHH", 0, *self.combos[idx])
        elif msg[2] == DYNAMIC_VIAL_COMBO_SET:
            idx = msg[3]
            keys = struct.unpack_from("<HHHHH", msg[4:])
            assert idx < len(self.combos)
            self.combos[idx] = keys
            return b""
        elif msg[2] == DYNAMIC_VIAL_TAP_DANCE_GET:
            idx = msg[3]
            assert idx < len(self.tap_dance)
            return struct.pack("<BHHHHH", 0, *self.tap_dance[idx])
        elif msg[2] == DYNAMIC_VIAL_TAP_DANCE_SET:
            idx = msg[3]
            values = struct.unpack_from("<HHHHH", msg[4:])
            assert idx < len(self.tap_dance)
            self.tap_dance[idx] = values
            return b""
        raise RuntimeError("unsupported dynamic submsg 0x{:02X}".format(msg[2]))

    def vial_cmd(self, msg):
        if msg[1] == CMD_VIAL_GET_KEYBOARD_ID:
            return struct.pack("<IQ", 6, 0xF00DFACEDEADBEEF)
        elif msg[1] == CMD_VIAL_GET_SIZE:
            return struct.pack("<I", len(self.keyboard_definition))
        elif msg[1] == CMD_VIAL_GET_DEFINITION:
            page = struct.unpack_from("<H", msg[2:])[0]
            return self.keyboard_definition[page*32:(page+1)*32]
        elif msg[1] == CMD_VIAL_GET_UNLOCK_STATUS:
            return struct.pack("<BB", 0, 0)  # TODO we want to test unlocking as well
        elif msg[1] == CMD_VIAL_QMK_SETTINGS_QUERY:
            return b"\xFF" * 32
        elif msg[1] == CMD_VIAL_DYNAMIC_ENTRY_OP:
            return self.vial_cmd_dynamic(msg)
        raise RuntimeError("unknown command for Vial protocol 0x{:02X}".format(msg[1]))

    def process(self, msg):
        if msg[0] == CMD_VIA_VIAL_PREFIX:
            return self.vial_cmd(msg)
        elif msg[0] == CMD_VIA_GET_PROTOCOL_VERSION:
            return struct.pack(">BH", msg[0], 9)
        elif msg[0] == CMD_VIA_SET_KEYCODE:
            layer, row, col, kc = struct.unpack_from(">BBBH", msg[1:])
            self.keymap[layer][row][col] = kc
            return b""
        elif msg[0] == CMD_VIA_MACRO_GET_COUNT:
            return struct.pack(">BB", msg[0], self.macro_count)
        elif msg[0] == CMD_VIA_MACRO_GET_BUFFER_SIZE:
            return struct.pack(">BH", msg[0], len(self.macro_buffer))
        elif msg[0] == CMD_VIA_MACRO_GET_BUFFER:
            offset, size = struct.unpack_from(">HB", msg[1:])
            return msg[0:1] + self.macro_buffer[offset:offset+size]
        elif msg[0] == CMD_VIA_GET_LAYER_COUNT:
            return struct.pack(">BB", msg[0], self.layers)
        elif msg[0] == CMD_VIA_KEYMAP_GET_BUFFER:
            offset, size = struct.unpack_from(">HB", msg[1:])
            return msg[0:1] + self.get_keymap_buffer()[offset:offset+size]
        elif msg[0] == 0x55:
            # key colours: stock firmware leaves it to VIA, which answers id_unhandled
            return b"\xFF"
        elif msg[0] == 0x56:
            # slider targets: stock firmware leaves it to VIA, which answers id_unhandled
            return b"\xFF"
        raise RuntimeError("unknown command for VIA protocol 0x{:02X}".format(msg[0]))


class MockDevice:

    def open_path(self, path):
        assert path == "/magic/path/for/tests"

    def close(self):
        pass

    def write(self, data):
        assert len(data) == 33
        assert data[0] == 0
        self.msg = data[1:]

        return len(data)

    def read(self, sz, timeout_ms=None):
        assert sz == 32
        resp = self.vk.process(self.msg)
        assert len(resp) <= 32
        resp += b"\x00" * (32 - len(resp))
        return resp


class FakeAppctx:

    def get_resource(self, path):
        return os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../resources/base/", path)


all_mw = []


def prepare(qtbot, keyboard_json, combos=None, tap_dance=None):
    import hidraw as hid

    vk = VirtualKeyboard(keyboard_json, combos=combos, tap_dance=tap_dance)
    MockDevice.vk = vk

    hid.enumerate = mock_enumerate
    hid.device = MockDevice

    mw = MainWindow(FakeAppctx())
    qtbot.addWidget(mw)
    mw.show()
    # keep reference to MainWindow for the duration of tests
    # when MainWindow goes out of scope some KeyWidgets are still registered within KeycodeDisplay which causes UaF
    all_mw.append(mw)

    return mw, vk


def test_gui_startup(qtbot):
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)
    assert mw.combobox_devices.currentText() == "Vial Testing Ltd Test Keyboard"
    assert mw.combobox_devices.count() == 1


def test_no_key_colours_tab_on_stock_keyboard(qtbot):
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)
    labels = [mw.tabs.tabText(i) for i in range(mw.tabs.count())]
    assert "Keymap" in labels
    assert "Key colours" not in labels
    assert mw.key_colours_editor.device is mw.autorefresh.current_device


def test_no_slider_tab_on_stock_keyboard(qtbot):
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)
    labels = [mw.tabs.tabText(i) for i in range(mw.tabs.count())]
    assert "Keymap" in labels
    assert "Slider" not in labels
    assert mw.slider_targets_editor.device is mw.autorefresh.current_device


