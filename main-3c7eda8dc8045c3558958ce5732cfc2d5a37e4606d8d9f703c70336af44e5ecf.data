def test_key_change(qtbot):
    """ Tests changing keys in a keymap """
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)

    # nothing should be selected yet in the keyboard display
    assert mw.keymap_editor.container.active_key is None

    # initial keycode must be KC_NO
    assert vk.keymap[0][0][0] == 0

    # clicking on first key must activate it
    point = mw.keymap_editor.container.widgets[0].bbox[0]
    qtbot.mouseClick(mw.keymap_editor.container, qt_api.QtCore.Qt.MouseButton.LeftButton,
                     pos=QPoint(int(point.x()), int(point.y())))

    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[0]

    ak = mw.keymap_editor.tabbed_keycodes.all_keycodes
    bk = mw.keymap_editor.tabbed_keycodes.basic_keycodes

    # at this point we can select all keycodes so basic should be hidden
    assert ak.isVisible()
    assert not bk.isVisible()

    # change current key to B
    assert ak.currentIndex() == 0
    assert ak.tabText(ak.currentIndex()) == "Basic"
    btn = ak.widget(0).layout.itemAt(3).widget().buttons[3]
    assert btn.text == "B"
    qtbot.mouseClick(btn, qt_api.QtCore.Qt.MouseButton.LeftButton)

    # check the new keycode is KC_B
    assert vk.keymap[0][0][0] == 5

    # check that we moved to the next key after setting the first key
    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[1]

    def find_key_btn(start, text):
        for w in start.findChildren(SquareButton):
            if w.isVisible() and w.text == text:
                return w
        raise RuntimeError("cannot find a visible key button with text='{}'".format(text))

    # switch to the Quantum tab
    ak.setCurrentIndex(3)
    assert ak.tabText(ak.currentIndex()) == "Quantum"

    # change current key to a masked LCTL()
    btn = find_key_btn(ak, "LCtl\n(kc)")
    qtbot.mouseClick(btn, qt_api.QtCore.Qt.MouseButton.LeftButton)

    # check the new keycode is LCTL()
    assert vk.keymap[0][0][1] == 0x100

    # check that we moved to the next key after setting the second key
    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[2]

    # click back on the second key
    point = mw.keymap_editor.container.widgets[1].bbox[0]
    qtbot.mouseClick(mw.keymap_editor.container, qt_api.QtCore.Qt.MouseButton.LeftButton,
                     pos=QPoint(int(point.x()), int(point.y())))

    # check that we have the second key selected & it's not a mask
    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[1]
    assert not mw.keymap_editor.container.active_mask

    # click on the mask now by manually calculating somewhere within last 4/5th Y, midpoint X
    bbox = mw.keymap_editor.container.widgets[1].bbox
    min_x = min(p.x() for p in bbox)
    max_x = max(p.x() for p in bbox)
    min_y = min(p.y() for p in bbox)
    max_y = max(p.y() for p in bbox)
    qtbot.mouseClick(mw.keymap_editor.container, qt_api.QtCore.Qt.MouseButton.LeftButton,
                     pos=QPoint(int((min_x + max_x) / 2), int(min_y + (max_y - min_y) * 4/5)))
    # now we must have the inner selected on the same key
    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[1]
    assert mw.keymap_editor.container.active_mask

    # now only basic keys should be settable
    assert not ak.isVisible()
    assert bk.isVisible()

    # let's set key C
    btn = find_key_btn(bk, "C")
    qtbot.mouseClick(btn, qt_api.QtCore.Qt.MouseButton.LeftButton)

    # check the new keycode is LCTL(KC_C)
    assert vk.keymap[0][0][1] == 0x106

    # and we should have moved to the next key, setting the full key and not the inner
    assert mw.keymap_editor.container.active_key == mw.keymap_editor.container.widgets[2]
    assert not mw.keymap_editor.container.active_mask
    assert ak.isVisible()
    assert not bk.isVisible()


def test_keymap_zoom(qtbot):
    """ Tests zooming keymap in/out using +/- keys """
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)

    btn_plus = mw.keymap_editor.layout_size.itemAt(0).widget()
    btn_minus = mw.keymap_editor.layout_size.itemAt(1).widget()
    # TODO: resolve this field collision, +/- are SquareButton which overrides text
    assert QPushButton.text(btn_plus) == "+"
    assert QPushButton.text(btn_minus) == "-"

    # grab area for first widget
    scale_initial = mw.keymap_editor.container.scale

    # click the plus button
    qtbot.mouseClick(btn_plus, qt_api.QtCore.Qt.MouseButton.LeftButton)
    # area got bigger
    assert mw.keymap_editor.container.scale > scale_initial

    # click the minus button
    qtbot.mouseClick(btn_minus, qt_api.QtCore.Qt.MouseButton.LeftButton)
    # area back to the initial
    assert abs(mw.keymap_editor.container.scale - scale_initial) < 0.01

    # click the minus button
    qtbot.mouseClick(btn_minus, qt_api.QtCore.Qt.MouseButton.LeftButton)
    # area got smaller
    assert mw.keymap_editor.container.scale < scale_initial


def find_key_btn(start, text):
    for w in start.findChildren(SquareButton):
        if w.isVisible() and w.text == text:
            return w
    raise RuntimeError("cannot find a visible key button with text='{}'".format(text))


def test_layer_switch(qtbot):
    """ Tests setting keycodes across different layers """
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)

    ak = mw.keymap_editor.tabbed_keycodes.all_keycodes
    bk = mw.keymap_editor.tabbed_keycodes.basic_keycodes
    c = mw.keymap_editor.container

    # initial keycode must be KC_NO
    assert vk.keymap[0][0][0] == 0

    # clicking on first key must activate it
    point = c.widgets[0].bbox[0]
    qtbot.mouseClick(c, qt_api.QtCore.Qt.MouseButton.LeftButton,
                     pos=QPoint(int(point.x()), int(point.y())))
    assert c.active_key == c.widgets[0]

    # change current key to Z
    qtbot.mouseClick(find_key_btn(ak, "Z"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.keymap[0][0][0] == 0x1D
    assert vk.keymap[1][0][0] == 0

    # make sure display for the widget now says Z
    assert c.widgets[0].text == "Z"
    # and that the next key is selected
    assert c.active_key == c.widgets[1]
    assert not c.active_mask

    # go to layer 1
    btn_layer_0 = mw.keymap_editor.layer_buttons[0]
    btn_layer_1 = mw.keymap_editor.layer_buttons[1]
    # TODO: resolve this field collision, +/- are SquareButton which overrides text
    assert QPushButton.text(btn_layer_0) == "0"
    assert QPushButton.text(btn_layer_1) == "1"

    qtbot.mouseClick(btn_layer_1, qt_api.QtCore.Qt.MouseButton.LeftButton)
    # check the current key got deselected
    assert c.active_key is None
    assert not c.active_mask

    # check the widget now displays layer 1 data, i.e. empty string as it's not set yet
    assert c.widgets[0].text == ""

    # click the key again
    qtbot.mouseClick(c, qt_api.QtCore.Qt.MouseButton.LeftButton,
                     pos=QPoint(int(point.x()), int(point.y())))
    assert c.active_key == c.widgets[0]

    # change current key to Y
    qtbot.mouseClick(find_key_btn(ak, "Y"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.keymap[0][0][0] == 0x1D
    assert vk.keymap[1][0][0] == 0x1C

    # make sure display for the widget now says Y
    assert c.widgets[0].text == "Y"

    # go back to the layer 0 and make sure the button got redrawn to Z
    qtbot.mouseClick(btn_layer_0, qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert c.widgets[0].text == "Z"


def test_combos(qtbot):
    from widgets.key_widget import KeyWidget

    """ Tests setting combo keycodes """
    mw, vk = prepare(qtbot, FAKE_KEYBOARD, combos=[[0, 0, 0, 0, 0], [4, 5, 6, 7, 8], [0, 0x106, 0, 0, 0]])

    combos = None
    for x in range(mw.tabs.count()):
        if mw.tabs.tabText(x) == "Combos":
            combos = mw.tabs.widget(x).editor

    assert combos is not None, "could not find the combos tab"
    ct = combos.tabs

    tabs = []
    for x in range(ct.count()):
        tabs.append(ct.tabText(x))
    assert tabs == ["1", "2", "3"]

    def check_tab(idx, keys):
        ct.setCurrentIndex(idx)
        assert ct.tabText(ct.currentIndex()) == str(idx + 1)
        w = ct.widget(ct.currentIndex()).findChildren(KeyWidget)
        assert len(w) == 5
        for x in range(5):
            assert w[x].keycode == keys[x], "unexpected keycode at tab {} position {}: {} vs {}".format(idx, x, w[x].keycode, keys[x])

    check_tab(0, ["KC_NO", "KC_NO", "KC_NO", "KC_NO", "KC_NO"])
    check_tab(1, ["KC_A", "KC_B", "KC_C", "KC_D", "KC_E"])
    check_tab(2, ["KC_NO", "LCTL(KC_C)", "KC_NO", "KC_NO", "KC_NO"])

    # ok now still on tab index 2, let's switch some combos
    # change "Key 1" to "A"
    assert not mw.tray_keycodes.isVisible()
    w = ct.widget(ct.currentIndex()).findChildren(KeyWidget)
    bbox = w[0].widgets[0].bbox
    min_x = min(p.x() for p in bbox)
    max_x = max(p.x() for p in bbox)
    min_y = min(p.y() for p in bbox)
    max_y = max(p.y() for p in bbox)
    pos_mask = QPoint(int((min_x + max_x) / 2), int(min_y + (max_y - min_y) * 4/5))
    pos = QPoint(bbox[0].x(), bbox[0].y())
    qtbot.mouseClick(w[0], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos)
    assert mw.tray_keycodes.isVisible()

    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "A"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.combos[2] == (4, 0x106, 0, 0, 0)

    # change "Output key" to "B"
    qtbot.mouseClick(w[4], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos)
    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "B"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.combos[2] == (4, 0x106, 0, 0, 5)

    ak = mw.tray_keycodes.all_keycodes
    bk = mw.tray_keycodes.basic_keycodes

    # change "Key 4" to LSft(D)
    # first set up LSft(kc)
    qtbot.mouseClick(w[3], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos)
    assert ak.isVisible()
    assert not bk.isVisible()
    ak.setCurrentIndex(3)
    assert ak.tabText(ak.currentIndex()) == "Quantum"
    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "LSft\n(kc)"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.combos[2] == (4, 0x106, 0, 0x200, 5)
    # now click the mask and set up D inside
    qtbot.mouseClick(w[3], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos_mask)
    assert not ak.isVisible()
    assert bk.isVisible()
    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "D"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.combos[2] == (4, 0x106, 0, 0x207, 5)

    # change "Key 2" to E
    qtbot.mouseClick(w[1], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos)
    assert ak.isVisible()
    assert not bk.isVisible()
    ak.setCurrentIndex(0)
    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "E"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.combos[2] == (4, 8, 0, 0x207, 5)

    # check the final result in the gui as well
    check_tab(2, ["KC_A", "KC_E", "KC_NO", "LSFT(KC_D)", "KC_B"])

    # TODO: a future unit test should check switching between multiple keyboards with different number of combos


def test_tap_dance(qtbot):
    from widgets.key_widget import KeyWidget
    from PyQt5.QtWidgets import QSpinBox

    mw, vk = prepare(qtbot, FAKE_KEYBOARD, tap_dance=[[0, 0, 0, 0, 200], [4, 5, 6, 7, 200], [0, 0x106, 0, 0, 500]])

    # TODO: a future unit test should check switching between multiple keyboards with different number of tap dances

    tde = None
    for x in range(mw.tabs.count()):
        if mw.tabs.tabText(x) == "Tap Dance":
            tde = mw.tabs.widget(x).editor

    assert tde is not None, "could not find the combos tab"
    td = tde.tabs

    tabs = []
    for x in range(td.count()):
        tabs.append(td.tabText(x))
    assert tabs == ["0", "1", "2"]

    def check_tab(idx, keys, timeout):
        td.setCurrentIndex(idx)
        assert td.tabText(td.currentIndex()) == str(idx)
        w = td.widget(td.currentIndex()).findChildren(KeyWidget)
        assert len(w) == 4
        for x in range(4):
            assert w[x].keycode == keys[x], "unexpected keycode at tab {} position {}: {} vs {}".format(idx, x, w[x].keycode, keys[x])
        timeout_w = td.widget(td.currentIndex()).findChildren(QSpinBox)[0]
        assert timeout_w.value() == timeout

    check_tab(0, ["KC_NO", "KC_NO", "KC_NO", "KC_NO"], 200)
    check_tab(1, ["KC_A", "KC_B", "KC_C", "KC_D"], 200)
    check_tab(2, ["KC_NO", "LCTL(KC_C)", "KC_NO", "KC_NO"], 500)

    # ok now still on tab index 2, let's switch the tap dance
    # change "Key 1" to "A"
    assert not mw.tray_keycodes.isVisible()
    w = td.widget(td.currentIndex()).findChildren(KeyWidget)
    bbox = w[0].widgets[0].bbox
    min_x = min(p.x() for p in bbox)
    max_x = max(p.x() for p in bbox)
    min_y = min(p.y() for p in bbox)
    max_y = max(p.y() for p in bbox)
    pos_mask = QPoint(int((min_x + max_x) / 2), int(min_y + (max_y - min_y) * 4/5))
    pos = QPoint(bbox[0].x(), bbox[0].y())
    qtbot.mouseClick(w[0], qt_api.QtCore.Qt.MouseButton.LeftButton, pos=pos)
    assert mw.tray_keycodes.isVisible()

    # note that for the tap dance the keycode change is immediate but not the timeout change
    qtbot.mouseClick(find_key_btn(mw.tray_keycodes, "A"), qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert vk.tap_dance[2] == (4, 0x106, 0, 0, 500)

    timeout_w = td.widget(td.currentIndex()).findChildren(QSpinBox)[0]
    timeout_w.setValue(123)
    assert vk.tap_dance[2] == (4, 0x106, 0, 0, 500)

    # check that we are adding * to the tab text when there are pending changes
    assert td.tabText(td.currentIndex()) == "2*"
    timeout_w.setValue(500)
    assert td.tabText(td.currentIndex()) == "2"

    # ok commit the change now
    timeout_w.setValue(123)
    assert td.tabText(td.currentIndex()) == "2*"
    qtbot.mouseClick(tde.btn_save, qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert td.tabText(td.currentIndex()) == "2"
    assert vk.tap_dance[2] == (4, 0x106, 0, 0, 123)

    # let's check that reverting works
    assert not tde.btn_save.isEnabled()
    timeout_w.setValue(321)
    assert tde.btn_save.isEnabled()
    assert td.tabText(td.currentIndex()) == "2*"

    qtbot.mouseClick(tde.btn_revert, qt_api.QtCore.Qt.MouseButton.LeftButton)
    assert not tde.btn_save.isEnabled()
    assert td.tabText(td.currentIndex()) == "2"
    assert timeout_w.value() == 123


def test_close_deactivates_current_tab(qtbot):
    mw, vk = prepare(qtbot, FAKE_KEYBOARD)
    assert mw.current_tab is not None
    calls = []
    mw.current_tab.editor.deactivate = lambda: calls.append(1)
    mw.close()
    assert calls == [1]
import json
import unittest
from unittest import mock

from test.test_slider_targets_protocol import make_kb, expect_reload, expect_set, expect_count, expect_flash, \
    TARGETS


def vil_kb(flash=None):
    kb, dev = make_kb()
    expect_reload(dev, [(62, (255, 255, 255), "Slider"), (7, (1, 2, 3), "Vol")], flash=flash)
    kb.reload_slider_targets()
    kb.key_colours_supported = False
    kb.keyboard_id = 1
    kb.layers = 0
    kb.rows = kb.cols = kb.encoder_count = 0
    kb.layout = {}
    kb.encoder_layout = {}
    kb.layout_options = 0
    kb.macro = b""
    kb.vial_protocol = kb.via_protocol = 0
    kb.tap_dance_entries = []
    kb.combo_entries = []
    kb.key_override_entries = []
    kb.alt_repeat_key_entries = []
    kb.tap_dance_count = kb.combo_count = kb.key_override_count = kb.alt_repeat_key_count = 0
    kb.settings = {}
    kb.macro_count = 0
    return kb, dev


def vil(kb, section, settings=None):
    data = json.loads(kb.save_layout().decode("utf-8"))
    if section is None:
        data.pop("slider_targets", None)
    else:
        data["slider_targets"] = section
    if settings is not None:
        data["settings"] = settings
    return json.dumps(data).encode("utf-8")


def good():
    return {"version": 1, "targets": [
        {"control": 62, "colour": "#ffffff", "name": "Slider"},
        {"control": 7, "colour": "#010203", "name": "Vol"}]}


def entry(control=1, colour="#000000", name="x"):
    return {"control": control, "colour": colour, "name": name}


class TestSliderTargetsVil(unittest.TestCase):

    def test_save_includes_targets(self):
        kb, dev = vil_kb()
        data = json.loads(kb.save_layout().decode("utf-8"))
        self.assertEqual(data["slider_targets"], good())

    def test_save_omits_when_unsupported(self):
        kb, dev = vil_kb()
        kb.slider_supported = False
        data = json.loads(kb.save_layout().decode("utf-8"))
        self.assertNotIn("slider_targets", data)

    def test_restore_writes(self):
        kb, dev = vil_kb()
        data = vil(kb, {"version": 1, "targets": [entry(5, "#0a0b0c", "Pad")]})
        t = TARGETS[0]._replace(control=5, colour=(10, 11, 12), name="Pad")
        expect_set(dev, 0, t)
        expect_count(dev, 1)
        kb.restore_layout(data)
        dev.finish()
        self.assertEqual(kb.slider_targets, [t])

    def test_absent_section_sends_nothing(self):
        kb, dev = vil_kb()
        kb.restore_layout(vil(kb, None))
        dev.finish()

    def test_invalid_sections_send_nothing_and_settings_restore(self):
        bad = [
            {"version": 1, "targets": [entry()] * 9},
            {"version": 1, "targets": [entry(control=128)]},
            {"version": 1, "targets": [entry(name="x" * 13)]},
            {"version": 1, "targets": [entry(colour="red")]},
        ]
        for section in bad:
            kb, dev = vil_kb()
            data = vil(kb, section, {"5": 9})
            with mock.patch.object(kb, "qmk_settings_set") as ms, \
                    mock.patch("editor.qmk_settings.QmkSettings.is_qsid_supported", return_value=True):
                with self.assertLogs("protocol.keyboard_comm", "WARNING"):
                    kb.restore_layout(data)
            dev.finish()
            ms.assert_called_once_with(5, 9)

    def test_keyboard_error_warns_and_settings_restore(self):
        kb, dev = vil_kb()
        data = vil(kb, {"version": 1, "targets": [entry(5, "#0a0b0c", "Pad")]}, {"5": 9})
        req = bytes([0x56, 0x03, 0, 5, 10, 11, 12]) + b"Pad".ljust(12, b"\x00")
        dev.expect(req, bytes([0x56, 0xFF]) + req[2:])
        with mock.patch.object(kb, "qmk_settings_set") as ms, \
                mock.patch("editor.qmk_settings.QmkSettings.is_qsid_supported", return_value=True):
            with self.assertLogs("protocol.keyboard_comm", "WARNING"):
                kb.restore_layout(data)
        dev.finish()
        ms.assert_called_once_with(5, 9)

    def test_flash_leds_saved_and_restored(self):
        kb, dev = vil_kb(flash=0b101)
        data = json.loads(kb.save_layout().decode("utf-8"))
        self.assertEqual(data["slider_targets"]["flash_leds"], [0, 2])
        section = dict(data["slider_targets"], flash_leds=[1, 30])
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, TARGETS[1])
        expect_count(dev, 2)
        expect_flash(dev, (1 << 30) | 2)
        kb.restore_layout(vil(kb, section))
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, (1 << 30) | 2)

    def test_old_file_without_flash_leaves_mask(self):
        kb, dev = vil_kb(flash=0b101)
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, TARGETS[1])
        expect_count(dev, 2)
        kb.restore_layout(vil(kb, good()))
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, 0b101)
import struct
import unittest

from protocol.keyboard_comm import Keyboard
from test.test_keyboard import SimulatedDevice


def make_kb(vialrgb=True):
    dev = SimulatedDevice()
    kb = Keyboard(dev, dev.sim_send)
    kb.lighting_vialrgb = vialrgb
    return kb, dev


def entry_bytes(entries):
    out = b""
    for e in entries:
        out += bytes([0, 0, 0, 0]) if e is None else bytes([1, e[0], e[1], e[2]])
    return out


def expect_reload(dev, layers, leds, colours, initialised=1):
    """ colours[layer][led] -> (r,g,b) or None """
    dev.expect("5501", struct.pack("<BBBBHB", 0x55, 0x01, 1, layers, leds, initialised))
    dev.expect("0843", struct.pack("<BBH", 0x08, 0x43, leds))
    for i in range(leds):
        dev.expect(struct.pack("<BBH", 0x08, 0x44, i),
                   bytes([0x08, 0x44, i * 10, i * 3, 4, i // 4, i % 4]))
    for layer in range(layers):
        start = 0
        while start < leds:
            n = min(6, leds - start)
            req = struct.pack("BBBBB", 0x55, 0x02, layer, start, n)
            dev.expect(req, req + entry_bytes(colours[layer][start:start + n]))
            start += n


class TestKeyColoursProtocol(unittest.TestCase):

    def test_unsupported_reply(self):
        kb, dev = make_kb()
        dev.expect("5501", "FF" * 32)
        kb.reload_key_colours()
        self.assertIs(kb.key_colours_supported, False)
        dev.finish()

    def test_wrong_version_unsupported(self):
        kb, dev = make_kb()
        dev.expect("5501", "5501" + "02020700" + "01")
        kb.reload_key_colours()
        self.assertIs(kb.key_colours_supported, False)
        dev.finish()

    def test_not_vialrgb_sends_nothing(self):
        kb, dev = make_kb(vialrgb=False)
        kb.reload_key_colours()
        self.assertIs(kb.key_colours_supported, False)
        dev.finish()

    def reloaded(self):
        kb, dev = make_kb()
        colours = [
            [(1, 2, 3), None, (4, 5, 6), None, None, None, (255, 255, 255)],
            [None] * 7,
        ]
        expect_reload(dev, 2, 7, colours)
        kb.reload_key_colours()
        return kb, dev, colours

    def test_reload_reads_info_leds_and_colours(self):
        kb, dev, colours = self.reloaded()
        dev.finish()
        self.assertIs(kb.key_colours_supported, True)
        self.assertEqual(kb.key_colours_layers, 2)
        self.assertEqual(kb.key_colours_led_count, 7)
        self.assertIs(kb.key_colours_initialised, True)
        self.assertEqual(kb.key_colours, colours)
        self.assertEqual(len(kb.leds), 7)
        self.assertEqual(tuple(kb.leds[2]), (20, 6, 4, 0, 2))
        self.assertEqual(kb.leds[5].row, 1)

    def test_set_groups_contiguous_runs(self):
        kb, dev, _ = self.reloaded()
        changes = {i: (i, i + 1, i + 2) for i in (0, 1, 2, 3, 4, 5, 6, 9)}
        changes[1] = None
        # led 9 is out of the 7 LED range in this fixture's cache; use a bigger board
        kb.key_colours_led_count = 10
        kb.key_colours[1] = [None] * 10
        for start, n in ((0, 6), (6, 1), (9, 1)):
            req = struct.pack("BBBBB", 0x55, 0x03, 1, start, n) + entry_bytes(
                [changes[i] for i in range(start, start + n)])
            dev.expect(req, req)
        kb.key_colours_initialised = False
        kb.set_key_colours(1, changes)
        dev.finish()
        self.assertIs(kb.key_colours_initialised, True)
        self.assertEqual(kb.key_colours[1][0], (0, 1, 2))
        self.assertIsNone(kb.key_colours[1][1])
        self.assertEqual(kb.key_colours[1][9], (9, 10, 11))

    def test_set_error_raises(self):
        kb, dev, _ = self.reloaded()
        req = struct.pack("BBBBB", 0x55, 0x03, 0, 2, 1) + entry_bytes([(9, 9, 9)])
        dev.expect(req, bytes([0x55, 0xFF]))
        with self.assertRaises(RuntimeError):
            kb.set_key_colours(0, {2: (9, 9, 9)})
        self.assertEqual(kb.key_colours[0][2], (4, 5, 6))

    def test_preview(self):
        kb, dev, _ = self.reloaded()
        dev.expect("550401", "550401")
        dev.expect("5504FF", "5504FF")
        kb.set_key_colours_preview(1)
        kb.set_key_colours_preview(None)
        dev.finish()

    def test_json_roundtrip_and_shape_mismatch(self):
        kb, dev, colours = self.reloaded()
        data = kb.key_colours_to_json()
        self.assertEqual(data["version"], 1)
        self.assertEqual(data["layers"][0][0], "#010203")
        self.assertIsNone(data["layers"][0][1])
        self.assertEqual(data["layers"][0][6], "#ffffff")

        # roundtrip: layer 0 -> 6 + 1 entries, layer 1 -> 6 + 1 entries
        for layer in range(2):
            for start, n in ((0, 6), (6, 1)):
                req = struct.pack("BBBBB", 0x55, 0x03, layer, start, n) + entry_bytes(
                    colours[layer][start:start + n])
                dev.expect(req, req)
        self.assertTrue(kb.key_colours_from_json(data))
        dev.finish()

        three = {"version": 1, "layers": data["layers"] + [data["layers"][0]]}
        self.assertFalse(kb.key_colours_from_json(three))
        short = {"version": 1, "layers": [data["layers"][0][:6], data["layers"][1]]}
        self.assertFalse(kb.key_colours_from_json(short))
        self.assertFalse(kb.key_colours_from_json({"version": 2, "layers": data["layers"]}))
        self.assertFalse(kb.key_colours_from_json("junk"))
        dev.finish()


if __name__ == "__main__":
    unittest.main()
import unittest

from editor.key_colours_history import ColourHistory


class TestColourHistory(unittest.TestCase):

    def test_stroke_keeps_first_old(self):
        h = ColourHistory()
        h.begin_stroke(2)
        h.record(1, (1, 1, 1), (9, 9, 9))
        h.record(2, None, (8, 8, 8))
        h.record(1, (9, 9, 9), (7, 7, 7))
        h.end_stroke()
        self.assertTrue(h.can_undo())
        self.assertEqual(h.undo(), (2, {1: (1, 1, 1), 2: None}))
        self.assertFalse(h.can_undo())

    def test_empty_stroke_not_pushed(self):
        h = ColourHistory()
        h.begin_stroke(0)
        h.end_stroke()
        self.assertFalse(h.can_undo())

    def test_limit_drops_oldest(self):
        h = ColourHistory(limit=2)
        for n in range(3):
            h.begin_stroke(n)
            h.record(n, None, (n, n, n))
            h.end_stroke()
        self.assertEqual(h.undo()[0], 2)
        self.assertEqual(h.undo()[0], 1)
        self.assertIsNone(h.undo())

    def test_undo_empty(self):
        self.assertIsNone(ColourHistory().undo())
import struct
import unittest

from protocol.keyboard_comm import Keyboard
from protocol.key_colours import LedInfo
from protocol.slider_targets import SliderTarget
from test.test_keyboard import SimulatedDevice


def make_kb(vialrgb=True):
    dev = SimulatedDevice()
    kb = Keyboard(dev, dev.sim_send)
    kb.lighting_vialrgb = vialrgb
    return kb, dev


def name12(name):
    return name.encode("ascii").ljust(12, b"\x00")


def expect_reload(dev, targets, current=0, flash=None):
    """ flash: None for version-1 firmware, else the mask a version-2 firmware reports. """
    dev.expect("5601", bytes([0x56, 0x01, 1 if flash is None else 2, 8, len(targets), current, 12]))
    for i, t in enumerate(targets):
        req = bytes([0x56, 0x02, i])
        dev.expect(req, req + bytes([t[0], t[1][0], t[1][1], t[1][2]]) + name12(t[2]))
    if flash is not None:
        dev.expect("5605", struct.pack("<BBI", 0x56, 0x05, flash))


def expect_flash(dev, mask):
    req = struct.pack("<BBI", 0x56, 0x06, mask)
    dev.expect(req, req)


def expect_set(dev, idx, t):
    req = bytes([0x56, 0x03, idx, t.control, t.colour[0], t.colour[1], t.colour[2]]) + name12(t.name)
    dev.expect(req, req)


def expect_count(dev, n):
    req = bytes([0x56, 0x04, n])
    dev.expect(req, req)


TARGETS = [SliderTarget(62, (255, 255, 255), "Slider"), SliderTarget(7, (1, 2, 3), "Vol")]


class TestSliderTargetsProtocol(unittest.TestCase):

    def loaded(self, current=0):
        kb, dev = make_kb()
        expect_reload(dev, [(62, (255, 255, 255), "Slider"), (7, (1, 2, 3), "Vol")], current)
        kb.reload_slider_targets()
        dev.finish()
        return kb, dev

    def test_unsupported_reply(self):
        kb, dev = make_kb()
        dev.expect("5601", "FF" * 32)
        kb.reload_slider_targets()
        dev.finish()
        self.assertIs(kb.slider_supported, False)
        self.assertEqual(kb.slider_targets, [])

    def test_wrong_version_unsupported(self):
        kb, dev = make_kb()
        dev.expect("5601", bytes([0x56, 0x01, 3, 8, 1, 0, 12]))
        kb.reload_slider_targets()
        dev.finish()
        self.assertIs(kb.slider_supported, False)

    def test_not_vialrgb_sends_nothing(self):
        kb, dev = make_kb(vialrgb=False)
        kb.reload_slider_targets()
        dev.finish()
        self.assertIs(kb.slider_supported, False)

    def test_reload(self):
        kb, dev = self.loaded(current=1)
        self.assertIs(kb.slider_supported, True)
        self.assertEqual(kb.slider_max, 8)
        self.assertEqual(kb.slider_name_max, 12)
        self.assertEqual(kb.slider_current, 1)
        self.assertEqual(kb.slider_targets, TARGETS)

    def test_reload_name_stops_at_nul_and_replaces_bad_bytes(self):
        kb, dev = make_kb()
        dev.expect("5601", bytes([0x56, 0x01, 1, 8, 1, 0, 12]))
        dev.expect("560200", bytes([0x56, 2, 0, 5, 9, 8, 7]) + b"A\xffB\x00junk" + b"\x00" * 4)
        kb.reload_slider_targets()
        dev.finish()
        self.assertEqual(kb.slider_targets[0].name, "Aï¿½B")

    def test_set_writes_each_then_count(self):
        kb, dev = self.loaded(current=1)
        new = [TARGETS[1], TARGETS[0], SliderTarget(1, (0, 0, 0), "")]
        for i, t in enumerate(new):
            expect_set(dev, i, t)
        expect_count(dev, 3)
        kb.set_slider_targets(new)
        dev.finish()
        self.assertEqual(kb.slider_targets, new)
        self.assertEqual(kb.slider_current, 1)

    def test_set_clamps_current(self):
        kb, dev = self.loaded(current=1)
        expect_set(dev, 0, TARGETS[0])
        expect_count(dev, 1)
        kb.set_slider_targets(TARGETS[:1])
        dev.finish()
        self.assertEqual(kb.slider_current, 0)

    def test_error_reply_raises(self):
        kb, dev = self.loaded()
        dev.expect(bytes([0x56, 0x03, 0, 62, 255, 255, 255]) + name12("Slider"),
                   bytes([0x56, 0xFF]))
        with self.assertRaises(RuntimeError):
            kb.set_slider_targets(TARGETS[:1])
        dev.finish()
        self.assertEqual(kb.slider_targets, TARGETS)

    def test_invalid_raises_before_sending(self):
        kb, dev = self.loaded()
        bad = [
            [],
            [TARGETS[0]] * 9,
            [SliderTarget(62, (255, 255, 255), "x" * 13)],
            [SliderTarget(62, (255, 255, 255), "cafÃ©")],
            [SliderTarget(128, (255, 255, 255), "a")],
            [SliderTarget(-1, (255, 255, 255), "a")],
            [SliderTarget(1, (256, 0, 0), "a")],
            [SliderTarget(1, (0, 0), "a")],
            [SliderTarget(True, (0, 0, 0), "a")],
        ]
        for b in bad:
            with self.assertRaises(ValueError):
                kb.set_slider_targets(b)
        dev.finish()
        self.assertEqual(kb.slider_targets, TARGETS)

    def test_to_json(self):
        kb, dev = self.loaded()
        self.assertEqual(kb.slider_targets_to_json(), {
            "version": 1,
            "targets": [{"control": 62, "colour": "#ffffff", "name": "Slider"},
                        {"control": 7, "colour": "#010203", "name": "Vol"}]})

    def test_from_json_round_trip(self):
        kb, dev = self.loaded()
        data = kb.slider_targets_to_json()
        data["targets"][1]["colour"] = "#0A0b0C"
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, SliderTarget(7, (10, 11, 12), "Vol"))
        expect_count(dev, 2)
        self.assertIs(kb.slider_targets_from_json(data), True)
        dev.finish()

    def test_from_json_invalid_sends_nothing(self):
        kb, dev = self.loaded()
        good = {"control": 1, "colour": "#000000", "name": "a"}

        def t(**kw):
            d = dict(good)
            d.update(kw)
            return d

        bad = [
            None, [], {}, {"version": 2, "targets": [good]},
            {"version": 1}, {"version": 1, "targets": []},
            {"version": 1, "targets": "x"},
            {"version": 1, "targets": [good] * 9},
            {"version": 1, "targets": [1]},
            {"version": 1, "targets": [{"control": 1}]},
            {"version": 1, "targets": [t(control=128)]},
            {"version": 1, "targets": [t(control=-1)]},
            {"version": 1, "targets": [t(control="1")]},
            {"version": 1, "targets": [t(control=True)]},
            {"version": 1, "targets": [t(colour="#12345")]},
            {"version": 1, "targets": [t(colour="#12345g")]},
            {"version": 1, "targets": [t(colour="#1234567\n")]},
            {"version": 1, "targets": [t(colour=5)]},
            {"version": 1, "targets": [t(name="x" * 13)]},
            {"version": 1, "targets": [t(name="cafÃ©")]},
            {"version": 1, "targets": [t(name=3)]},
        ]
        for b in bad:
            self.assertIs(kb.slider_targets_from_json(b), False, b)
        dev.finish()


RAW = [(62, (255, 255, 255), "Slider"), (7, (1, 2, 3), "Vol")]


def leds(n):
    return [LedInfo(i, 0, 4, 0, i) for i in range(n)]


class TestSliderFlashProtocol(unittest.TestCase):

    def loaded(self, flash=0x7FFFFFFF, n_leds=31):
        kb, dev = make_kb()
        kb.leds = leds(n_leds)
        expect_reload(dev, RAW, flash=flash)
        kb.reload_slider_targets()
        dev.finish()
        return kb, dev

    def test_version_1_has_no_flash(self):
        kb, dev = make_kb()
        expect_reload(dev, RAW)
        kb.reload_slider_targets()
        dev.finish()
        self.assertIs(kb.slider_supported, True)
        self.assertIs(kb.slider_flash_supported, False)
        self.assertNotIn("flash_leds", kb.slider_targets_to_json())

    def test_version_2_reads_mask(self):
        kb, dev = self.loaded(flash=0x12345678)
        self.assertIs(kb.slider_supported, True)
        self.assertIs(kb.slider_flash_supported, True)
        self.assertEqual(kb.slider_flash_mask, 0x12345678)
        self.assertEqual(kb.slider_targets, TARGETS)

    def test_get_flash_error_raises(self):
        kb, dev = make_kb()
        dev.expect("5601", bytes([0x56, 0x01, 2, 8, 0, 0, 12]))
        dev.expect("5605", bytes([0x56, 0xFF]))
        with self.assertRaises(RuntimeError):
            kb.reload_slider_targets()
        dev.finish()
        self.assertIs(kb.slider_supported, False)
        self.assertIs(kb.slider_flash_supported, False)

    def test_set_mask(self):
        kb, dev = self.loaded()
        expect_flash(dev, 0x00010203)
        kb.set_slider_flash_mask(0x00010203)
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, 0x00010203)

    def test_set_mask_error_keeps_mask(self):
        kb, dev = self.loaded()
        dev.expect(struct.pack("<BBI", 0x56, 0x06, 5), bytes([0x56, 0xFF]))
        with self.assertRaises(RuntimeError):
            kb.set_slider_flash_mask(5)
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, 0x7FFFFFFF)

    def test_set_mask_invalid_sends_nothing(self):
        kb, dev = self.loaded()
        for bad in (-1, 1 << 32, "1", True, None):
            with self.assertRaises(ValueError):
                kb.set_slider_flash_mask(bad)
        dev.finish()

    def test_set_mask_unsupported_raises(self):
        kb, dev = make_kb()
        expect_reload(dev, RAW)
        kb.reload_slider_targets()
        with self.assertRaises(RuntimeError):
            kb.set_slider_flash_mask(1)
        dev.finish()

    def test_to_json_lists_leds(self):
        kb, dev = self.loaded(flash=0b1000101)
        self.assertEqual(kb.slider_targets_to_json()["flash_leds"], [0, 2, 6])

    def test_to_json_only_existing_leds(self):
        # firmware default 0xFFFFFFFF on a keyboard with fewer LEDs
        kb, dev = self.loaded(flash=0xFFFFFFFF, n_leds=3)
        self.assertEqual(kb.slider_targets_to_json()["flash_leds"], [0, 1, 2])

    def test_from_json_writes_mask_after_targets(self):
        kb, dev = self.loaded()
        data = kb.slider_targets_to_json()
        data["flash_leds"] = [30, 1, 17]
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, TARGETS[1])
        expect_count(dev, 2)
        expect_flash(dev, (1 << 30) | (1 << 17) | 2)
        self.assertIs(kb.slider_targets_from_json(data), True)
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, (1 << 30) | (1 << 17) | 2)

    def test_from_json_without_flash_leaves_mask(self):
        kb, dev = self.loaded(flash=0x55)
        data = kb.slider_targets_to_json()
        del data["flash_leds"]
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, TARGETS[1])
        expect_count(dev, 2)
        self.assertIs(kb.slider_targets_from_json(data), True)
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, 0x55)

    def test_from_json_flash_on_version_1_firmware_ignored(self):
        kb, dev = make_kb()
        expect_reload(dev, RAW)
        kb.reload_slider_targets()
        data = kb.slider_targets_to_json()
        data["flash_leds"] = [0, 1]
        expect_set(dev, 0, TARGETS[0])
        expect_set(dev, 1, TARGETS[1])
        expect_count(dev, 2)
        self.assertIs(kb.slider_targets_from_json(data), True)
        dev.finish()

    def test_from_json_invalid_flash_sends_nothing(self):
        kb, dev = self.loaded(n_leds=31)
        for bad in ("x", 3, [-1], [31], [32], ["1"], [True], [1.0], None):
            data = kb.slider_targets_to_json()
            data["flash_leds"] = bad
            self.assertIs(kb.slider_targets_from_json(data), False, bad)
        dev.finish()
        self.assertEqual(kb.slider_flash_mask, 0x7FFFFFFF)

    def test_from_json_flash_limit_32_without_led_info(self):
        kb, dev = self.loaded(n_leds=0)
        data = kb.slider_targets_to_json()
        self.assertEqual(data["flash_leds"], list(range(31)))
        data["flash_leds"] = [32]
        self.assertIs(kb.slider_targets_from_json(data), False)
        dev.finish()


if __name__ == "__main__":
    unittest.main()
import json
import struct
import unittest

from test.test_key_colours_protocol import make_kb, expect_reload, entry_bytes


def vil_kb():
    kb, dev = make_kb()
    colours = [[(1, 2, 3), None, (4, 5, 6)], [None, (7, 8, 9), None]]
    expect_reload(dev, 2, 3, colours)
    kb.reload_key_colours()
    kb.keyboard_id = 1
    kb.layers = 0
    kb.rows = kb.cols = kb.encoder_count = 0
    kb.layout = {}
    kb.encoder_layout = {}
    kb.layout_options = 0
    kb.macro = b""
    kb.vial_protocol = kb.via_protocol = 0
    kb.tap_dance_entries = []
    kb.combo_entries = []
    kb.key_override_entries = []
    kb.alt_repeat_key_entries = []
    kb.tap_dance_count = kb.combo_count = kb.key_override_count = kb.alt_repeat_key_count = 0
    kb.settings = {}
    kb.macro_count = 0
    return kb, dev, colours


def vil(kb, section):
    data = json.loads(kb.save_layout().decode("utf-8"))
    if section is None:
        data.pop("key_colours", None)
    else:
        data["key_colours"] = section
    return json.dumps(data).encode("utf-8")


def good():
    return {"version": 1, "layers": [["#010203", None, "#040506"], [None, "#070809", None]]}


class TestKeyColoursVil(unittest.TestCase):

    def test_save_includes_colours(self):
        kb, dev, colours = vil_kb()
        data = json.loads(kb.save_layout().decode("utf-8"))
        self.assertEqual(data["key_colours"], good())

    def test_save_omits_when_unsupported(self):
        kb, dev, colours = vil_kb()
        kb.key_colours_supported = False
        data = json.loads(kb.save_layout().decode("utf-8"))
        self.assertNotIn("key_colours", data)

    def test_restore_writes_matching(self):
        kb, dev, colours = vil_kb()
        for layer in range(2):
            req = struct.pack("BBBBB", 0x55, 0x03, layer, 0, 3) + entry_bytes(colours[layer])
            dev.expect(req, req)
        kb.restore_layout(vil(kb, good()))
        dev.finish()

    def test_restore_without_section_writes_nothing(self):
        kb, dev, _ = vil_kb()
        kb.restore_layout(vil(kb, None))
        dev.finish()

    def test_restore_unsupported_keyboard_ignores_section(self):
        kb, dev, _ = vil_kb()
        data = vil(kb, good())
        kb.key_colours_supported = False
        kb.restore_layout(data)
        dev.finish()

    def test_restore_bad_sections_write_nothing_and_do_not_raise(self):
        bad_sections = [
            {"version": 1, "layers": good()["layers"][:1]},
            {"version": 1, "layers": [["#010203", None], [None, None, None]]},
            {"version": 1, "layers": [["#010203", None, "#040506"], [None, "#-1-1-1", None]]},
            {"version": 1, "layers": [["#010203", None, "#040506"], [None, "#+1+1+1", None]]},
            {"version": 1, "layers": [["#010203", None, "#040506"], [None, "#12345g", None]]},
            {"version": 1, "layers": [["#010203", None, "#040506"], [None, 5, None]]},
            {"version": 1, "layers": [["#010203", None, "#040506"], "abc"]},
            {"version": 1, "layers": "abc"},
            {"version": 1, "layers": {"a": 1}},
            {"version": 1},
            {"version": 2, "layers": good()["layers"]},
            "junk",
            5,
        ]
        for section in bad_sections:
            kb, dev, _ = vil_kb()
            kb.restore_layout(vil(kb, section))
            dev.finish()

    def test_from_json_rejects_without_writing(self):
        kb, dev, _ = vil_kb()
        d = good()
        d["layers"][1][1] = "#-1-1-1"
        self.assertFalse(kb.key_colours_from_json(d))
        dev.finish()


