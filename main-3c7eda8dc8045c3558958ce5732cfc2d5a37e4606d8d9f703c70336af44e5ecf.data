import datetime
import hashlib
import struct
import time
import threading
import sys

from PyQt5.QtCore import pyqtSignal, QCoreApplication
from PyQt5.QtGui import QFontDatabase
from PyQt5.QtWidgets import QHBoxLayout, QLineEdit, QToolButton, QPlainTextEdit, QProgressBar, QFileDialog, QDialog, \
    QCheckBox

from editor.basic_editor import BasicEditor
from unlocker import Unlocker
from util import tr, chunks, find_vial_devices, pad_for_vibl
from vial_device import VialBootloader, VialKeyboard


def send_retries(dev, data, retries=200):
    """ Sends usb packet up to 'retries' times, returns True if success, False if failed """

    if len(data) != 64:
        raise RuntimeError("sending invalid data length")

    for x in range(retries):
        ret = dev.send(data)
        if ret == len(data) + 1:
            return True
        elif ret < 0:
            time.sleep(0.01)
        else:
            return False
    return False


CHUNK = 64


def cmd_flash(device, firmware, enable_insecure, log_cb, progress_cb, complete_cb, error_cb):
    if firmware[0:8] not in [b"VIALFW00", b"VIALFW01"]:
        return error_cb("Error: Invalid signature")

    fw_uid = firmware[8:16]
    fw_ts = struct.unpack("<Q", firmware[16:24])[0]
    log_cb("* Firmware build date: {} (UTC)".format(datetime.datetime.utcfromtimestamp(fw_ts)))

    fw_hash = firmware[32:64]
    fw_payload = firmware[64:]

    if hashlib.sha256(fw_payload).digest() != fw_hash:
        return error_cb("Error: Firmware failed integrity check\n\texpected={}\n\tgot={}".format(
            fw_hash.hex(),
            hashlib.sha256(fw_payload).hexdigest()
        ))

    # Check bootloader is correct version
    send_retries(device, pad_for_vibl(b"VC\x00"))
    ver = device.recv(8)[0]
    log_cb("* Bootloader version: {}".format(ver))
    if ver not in [0, 1]:
        return error_cb("Error: Unsupported bootloader version")

    send_retries(device, pad_for_vibl(b"VC\x01"))
    uid = device.recv(8)
    log_cb("* Vial ID: {}".format(uid.hex()))

    if uid == b"\xFF" * 8:
        log_cb("\n\n\n!!! WARNING !!!\nBootloader UID is not set, make sure to configure it"
               " before releasing production firmware\n!!! WARNING !!!\n\n")

    if uid != fw_uid:
        return error_cb("Error: Firmware package was built for different device\n\texpected={}\n\tgot={}".format(
            fw_uid.hex(),
            uid.hex()
        ))

    # OK all checks complete, we can flash now
    while len(fw_payload) % CHUNK != 0:
        fw_payload += b"\x00"

    # Flash
    log_cb("Flashing...")
    send_retries(device, pad_for_vibl(b"VC\x02" + struct.pack("<H", len(fw_payload) // CHUNK)))
    total = 0
    for part in chunks(fw_payload, CHUNK):
        if not send_retries(device, part):
            return error_cb("Error while sending data, firmware is corrupted")
        total += len(part)
        progress_cb(total / len(fw_payload))

    # Reboot
    log_cb("Rebooting...")
    # enable insecure mode on first boot in order to restore keymap/macros
    if enable_insecure:
        send_retries(device, pad_for_vibl(b"VC\x04"))
    send_retries(device, pad_for_vibl(b"VC\x03"))

    complete_cb("Done!")


class FirmwareFlasher(BasicEditor):
    log_signal = pyqtSignal(object)
    progress_signal = pyqtSignal(object)
    complete_signal = pyqtSignal(object)
    error_signal = pyqtSignal(object)

    def __init__(self, main, parent=None):
        super().__init__(parent)

        self.main = main

        self.log_signal.connect(self._on_log)
        self.progress_signal.connect(self._on_progress)
        self.complete_signal.connect(self._on_complete)
        self.error_signal.connect(self._on_error)

        self.selected_firmware_path = ""

        file_selector = QHBoxLayout()
        self.txt_file_selector = QLineEdit()
        self.txt_file_selector.setReadOnly(True)
        file_selector.addWidget(self.txt_file_selector)
        self.btn_select_file = QToolButton()
        self.btn_select_file.setText(tr("Flasher", "Select file..."))
        self.btn_select_file.clicked.connect(self.on_click_select_file)
        file_selector.addWidget(self.btn_select_file)
        self.addLayout(file_selector)
        self.txt_logger = QPlainTextEdit()
        self.txt_logger.setReadOnly(True)
        self.txt_logger.setFont(QFontDatabase.systemFont(QFontDatabase.FixedFont))
        self.addWidget(self.txt_logger)
        progress_flash = QHBoxLayout()
        self.progress_bar = QProgressBar()
        self.progress_bar.setRange(0, 100)
        progress_flash.addWidget(self.progress_bar)
        self.btn_flash = QToolButton()
        self.btn_flash.setText(tr("Flasher", "Flash"))
        self.btn_flash.clicked.connect(self.on_click_flash)
        progress_flash.addWidget(self.btn_flash)
        self.chk_restore_keymap = QCheckBox(main)
        self.chk_restore_keymap.hide()
        self.chk_restore_keymap.setText(tr("Flasher", "Restore current layout after flashing"))
        self.chk_restore_keymap.setChecked(True)
        self.addWidget(self.chk_restore_keymap)
        self.addLayout(progress_flash)

        self.device = None

        self.layout_restore = self.uid_restore = None

    def rebuild(self, device):
        super().rebuild(device)
        self.txt_logger.clear()

        if not self.valid():
            return

        if isinstance(self.device, VialBootloader):
            self.log("Valid Vial Bootloader device at {}".format(self.device.desc["path"].decode("utf-8")))
            self.chk_restore_keymap.hide()
        elif isinstance(self.device, VialKeyboard):
            self.log("Vial keyboard detected")
            self.chk_restore_keymap.show()

    def valid(self):
        return (isinstance(self.device, VialBootloader) or \
               (isinstance(self.device, VialKeyboard) and self.device.keyboard.vibl)) \
               and sys.platform != "emscripten"

    def find_device_with_uid(self, cls, uid):
        devices = find_vial_devices({"definitions": {}})
        for dev in devices:
            if isinstance(dev, cls) and dev.get_uid() == uid:
                return dev
        return None

    def on_click_select_file(self):
        dialog = QFileDialog()
        dialog.setDefaultSuffix("vfw")
        dialog.setAcceptMode(QFileDialog.AcceptOpen)
        dialog.setNameFilters(["Vial Firmware (*.vfw)"])
        if dialog.exec_() == QDialog.Accepted:
            self.selected_firmware_path = dialog.selectedFiles()[0]
            self.txt_file_selector.setText(self.selected_firmware_path)
            self.log("Firmware update package: {}".format(self.selected_firmware_path))

    def on_click_flash(self):
        if not self.selected_firmware_path:
            self.log("Error: Please select a firmware update package")
            return

        with open(self.selected_firmware_path, "rb") as inf:
            firmware = inf.read()

        if len(firmware) > 10 * 1024 * 1024:
            self.log("Error: Firmware is too large. Check you've selected the correct file")
            return

        self.log("Preparing to flash...")
        self.lock_ui()

        self.layout_restore = self.uid_restore = None

        if isinstance(self.device, VialKeyboard):
            # back up current layout
            if self.chk_restore_keymap.isChecked():
                self.log("Backing up current layout...")
                self.layout_restore = self.device.keyboard.save_layout()

            # keep track of which keyboard we should restore saved layout to
            self.uid_restore = self.device.keyboard.get_uid()
            firmware_uid = firmware[8:16]
            if self.uid_restore != firmware_uid:
                self.log("Error: Firmware UID does not match keyboard UID. Check that you have the correct file")
                self.unlock_ui(False)
                return

            Unlocker.unlock(self.device.keyboard)

            self.log("Restarting in bootloader mode...")
            self.device.keyboard.reset()

            # watch for bootloaders to appear and ask them for their UID, return one that matches the keyboard
            found = None
            while found is None:
                self.log("Looking for devices...")
                QCoreApplication.processEvents()
                time.sleep(1)
                found = self.find_device_with_uid(VialBootloader, self.uid_restore)

            self.log("Found Vial Bootloader device at {}".format(found.desc["path"].decode("utf-8")))
            found.open()
            self.device = found

        threading.Thread(target=lambda: cmd_flash(
            self.device, firmware, self.layout_restore is not None,
            self.on_log, self.on_progress, self.on_complete, self.on_error)).start()

    def on_log(self, line):
        self.log_signal.emit(line)

    def on_progress(self, progress):
        self.progress_signal.emit(progress)

    def on_complete(self, msg):
        self.complete_signal.emit(msg)

    def on_error(self, msg):
        self.error_signal.emit(msg)

    def _on_log(self, msg):
        self.log(msg)

    def _on_progress(self, progress):
        self.progress_bar.setValue(int(progress * 100))

    def _on_complete(self, msg):
        self.log(msg)
        self.progress_bar.setValue(100)

        # if we were asked to restore a layout, find keyboard with matching UID and restore the layout to it
        if self.layout_restore:
            found = None
            while found is None:
                self.log("Looking for devices...")
                QCoreApplication.processEvents()
                time.sleep(1)
                found = self.find_device_with_uid(VialKeyboard, self.uid_restore)

            self.log("Found Vial keyboard at {}".format(found.desc["path"].decode("utf-8")))
            found.open()
            self.device = found
            self.log("Restoring saved layout...")
            QCoreApplication.processEvents()
            found.keyboard.restore_layout(self.layout_restore)
            found.keyboard.lock()
            found.close()
            self.log("Done!")

        self.unlock_ui()

    def _on_error(self, msg):
        self.log(msg)
        self.unlock_ui(False)

    def log(self, line):
        self.txt_logger.appendPlainText("[{}] {}".format(datetime.datetime.now(), line))

    def lock_ui(self):
        self.btn_select_file.setEnabled(False)
        self.btn_flash.setEnabled(False)
        self.main.lock_ui()

    def unlock_ui(self, force_refresh=True):
        self.btn_select_file.setEnabled(True)
        self.btn_flash.setEnabled(True)
        self.main.unlock_ui()
        if force_refresh:
            self.main.on_click_refresh()
# SPDX-License-Identifier: GPL-2.0-or-later
import logging

from PyQt5.QtCore import QEvent, QObject, QRegularExpression, Qt, QTimer
from PyQt5.QtGui import QColor, QRegularExpressionValidator
from PyQt5.QtWidgets import QHBoxLayout, QLabel, QPushButton, QWidget, QVBoxLayout, QColorDialog, QLineEdit, \
    QSpinBox, QSizePolicy, QDialog

from editor.basic_editor import BasicEditor
from protocol.slider_targets import SliderTarget, ST_MAX_CONTROL
from util import tr
from vial_device import VialKeyboard
from widgets.clickable_label import ClickableLabel
from widgets.colour_keyboard_widget import ColourKeyboardWidget, LED_NO_KEY

NOTE_TEXT = "Assign the \"Next slider target\" key in the Keymap tab (it's in the User tab)."

REFRESH_INTERVAL_MS = 1000
DEFAULT_CONTROL = 62
CURRENT_MARK = "â–¶"


class _PressFilter(QObject):
    """ Calls back on a mouse press, letting the press through. """

    def __init__(self, callback):
        super().__init__()
        self.callback = callback

    def eventFilter(self, obj, event):
        if event.type() == QEvent.MouseButtonPress:
            self.callback()
        return False


def _swatch_style(colour):
    return "QLabel { background-color: %s; border: 1px solid palette(button-text); }" % QColor(*colour).name()


class TargetRow:
    """ The widgets of one target row. """

    def __init__(self, editor, idx, target, name_max, count):
        self.widget = QWidget()
        row = QHBoxLayout()
        row.setContentsMargins(0, 0, 0, 0)

        self.marker = QLabel()
        self.marker.setMinimumWidth(16)
        row.addWidget(self.marker)

        self.name = QLineEdit()
        self.name.setValidator(QRegularExpressionValidator(QRegularExpression("[ -~]*"), self.name))
        self.name.editingFinished.connect(lambda: editor.on_name_edited(idx))
        row.addWidget(self.name, 1)

        row.addWidget(QLabel(tr("SliderTargets", "Control:")))
        self.control = QSpinBox()
        self.control.setRange(0, ST_MAX_CONTROL)
        self.control.valueChanged.connect(lambda value: editor.on_control_changed(idx, value))
        row.addWidget(self.control)

        self.swatch = ClickableLabel(" ")
        self.swatch.setToolTip(tr("SliderTargets", "Colour"))
        self.swatch.setMinimumWidth(32)
        self.swatch.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Preferred)
        self.swatch.clicked.connect(lambda: editor.on_colour_clicked(idx))
        row.addWidget(self.swatch)

        self.up = QPushButton(tr("SliderTargets", "Up"))
        self.up.setEnabled(idx > 0)
        self.up.clicked.connect(lambda: editor.move(idx, -1))
        row.addWidget(self.up)
        self.down = QPushButton(tr("SliderTargets", "Down"))
        self.down.setEnabled(idx < count - 1)
        self.down.clicked.connect(lambda: editor.move(idx, 1))
        row.addWidget(self.down)
        self.remove = QPushButton(tr("SliderTargets", "Remove"))
        self.remove.setEnabled(count > 1)
        self.remove.clicked.connect(lambda: editor.remove(idx))
        row.addWidget(self.remove)

        self.widget.setLayout(row)
        # clicking anywhere on the row previews its colour in the flash drawing
        self.press_filter = _PressFilter(lambda: editor.preview(idx))
        for w in (self.widget, self.marker, self.name, self.control, self.control.findChild(QLineEdit),
                  self.swatch):
            w.installEventFilter(self.press_filter)
        self.show_target(target, name_max)

    def show_target(self, target, name_max):
        """ Show target's values without sending them back to the keyboard. """
        self.name.setMaxLength(name_max)
        if self.name.text() != target.name:
            self.name.setText(target.name)
        self.control.blockSignals(True)
        self.control.setValue(target.control)
        self.control.blockSignals(False)
        self.colour = tuple(target.colour)
        self.swatch.setStyleSheet(_swatch_style(self.colour))

    def set_current(self, current):
        self.marker.setText(CURRENT_MARK if current else "")
        font = self.name.font()
        font.setBold(current)
        self.name.setFont(font)


class SliderTargetsEditor(BasicEditor):
    """ Edit the list of MIDI controls the numpad's slider cycles through. """

    def __init__(self, layout_editor=None):
        super().__init__()
        self.layout_editor = layout_editor
        self.keyboard = None
        self.rows = []
        self.shown = []           # targets the rows were built from
        self.preview_idx = None   # row whose colour the flash drawing uses; None = current target
        self.stroke_mask = None   # flash mask being painted by the open stroke
        self.stroke_on = True     # whether the open stroke turns lights on or off
        self.flash_shown = None   # colours the flash drawing was last given
        self.dlg_color = None
        self.dlg_row = None
        self.write_error = False  # error label shows a failed write

        self.timer = QTimer()
        self.timer.setInterval(REFRESH_INTERVAL_MS)
        self.timer.timeout.connect(self.on_timer)

        self.error_label = QLabel()
        self.error_label.setStyleSheet("QLabel { color: #d32f2f; }")
        self.error_label.setWordWrap(True)
        self.error_label.hide()
        self.addWidget(self.error_label)

        self.rows_layout = QVBoxLayout()
        self.addLayout(self.rows_layout)

        buttons = QHBoxLayout()
        self.btn_add = QPushButton(tr("SliderTargets", "Add target"))
        self.btn_add.clicked.connect(self.add)
        buttons.addWidget(self.btn_add)
        buttons.addStretch()
        self.addLayout(buttons)

        self.note = QLabel(tr("SliderTargets", NOTE_TEXT))
        self.note.setWordWrap(True)
        self.addWidget(self.note)
        self._build_flash()
        self.addStretch()

        if layout_editor is not None:
            layout_editor.changed.connect(self.on_layout_changed)

    def _build_flash(self):
        self.flash_section = QWidget()
        box = QVBoxLayout()
        box.setContentsMargins(0, 0, 0, 0)
        box.addWidget(QLabel(tr("SliderTargets", "Lights that flash when switching target")))
        self.flash_widget = ColourKeyboardWidget()
        self.flash_widget.stroke_painted.connect(self.on_flash_painted)
        self.flash_widget.stroke_finished.connect(self.on_flash_finished)
        box.addWidget(self.flash_widget, 0, Qt.AlignHCenter)
        buttons = QHBoxLayout()
        self.btn_flash_all = QPushButton(tr("SliderTargets", "All"))
        self.btn_flash_all.clicked.connect(lambda: self._write_flash(self._led_mask(lambda led: True)))
        self.btn_flash_none = QPushButton(tr("SliderTargets", "None"))
        self.btn_flash_none.clicked.connect(lambda: self._write_flash(0))
        self.btn_flash_edges = QPushButton(tr("SliderTargets", "Edge lights only"))
        self.btn_flash_edges.clicked.connect(
            lambda: self._write_flash(self._led_mask(lambda led: led.row == LED_NO_KEY)))
        for btn in (self.btn_flash_all, self.btn_flash_none, self.btn_flash_edges):
            buttons.addWidget(btn)
        buttons.addStretch()
        box.addLayout(buttons)
        self.flash_section.setLayout(box)
        self.flash_section.hide()
        self.addWidget(self.flash_section)

    # ---- BasicEditor ----

    def valid(self):
        return isinstance(self.device, VialKeyboard) and bool(self.device.keyboard.slider_supported)

    def rebuild(self, device):
        super().rebuild(device)
        self.write_error = False
        self.error_label.hide()
        self.preview_idx = None
        self.stroke_mask = None
        if not self.valid():
            self.keyboard = None
            self.timer.stop()
            self._clear_rows()
            self.flash_section.hide()
            return
        self.keyboard = device.keyboard
        self._build_rows()
        self.on_layout_changed()

    def activate(self):
        if self.valid():
            self.timer.start()

    def deactivate(self):
        self.timer.stop()

    # ---- rows ----

    def _clear_rows(self):
        for row in self.rows:
            # a focused name field would emit editingFinished on hide, against the new list
            row.name.blockSignals(True)
            row.control.blockSignals(True)
            self.rows_layout.removeWidget(row.widget)
            row.widget.hide()
            row.widget.deleteLater()
        self.rows = []
        self.shown = []

    def _build_rows(self):
        self._clear_rows()
        targets = list(self.keyboard.slider_targets)
        for idx, t in enumerate(targets):
            row = TargetRow(self, idx, t, self.keyboard.slider_name_max, len(targets))
            self.rows_layout.addWidget(row.widget)
            self.rows.append(row)
        self.shown = targets
        self.btn_add.setEnabled(len(targets) < self.keyboard.slider_max)
        self._mark_current()
        self._show_flash()

    def _sync(self):
        """ Make the rows show the keyboard's targets, rebuilding only when the count changed. """
        targets = list(self.keyboard.slider_targets)
        if len(targets) != len(self.rows):
            self._build_rows()
            return
        for row, t in zip(self.rows, targets):
            row.show_target(t, self.keyboard.slider_name_max)
        self.shown = targets
        self.btn_add.setEnabled(len(targets) < self.keyboard.slider_max)
        self._mark_current()
        self._show_flash()

    def _mark_current(self):
        for idx, row in enumerate(self.rows):
            row.set_current(idx == self.keyboard.slider_current)

    # ---- keyboard I/O ----

    def _call(self, fn, *args, write=False):
        """ Run a keyboard call; on failure show the error inline instead of crashing.
        A failed write stays shown until the next successful write; refreshes never clear it. """
        try:
            fn(*args)
        except Exception as e:
            logging.warning("slider targets: %s", e)
            self.error_label.setText(tr("SliderTargets", "Could not talk to the keyboard: {}").format(e))
            self.error_label.show()
            self.write_error = self.write_error or write
            return False
        if write or not self.write_error:
            self.error_label.hide()
            self.write_error = False
        return True

    def _write(self, targets):
        """ Send the whole list; the rows then show what the keyboard holds. """
        self._call(self.keyboard.set_slider_targets, targets, write=True)
        self._sync()

    def _reload(self):
        kb = self.keyboard
        names = ("slider_supported", "slider_max", "slider_name_max", "slider_targets", "slider_current",
                 "slider_flash_supported", "slider_flash_mask")
        saved = {n: getattr(kb, n, None) for n in names}
        try:
            kb.reload_slider_targets()
            if not kb.slider_supported:
                raise RuntimeError("slider targets not available")
        except Exception:
            # keep the last known state so the tab stays usable
            for n, value in saved.items():
                setattr(kb, n, value)
            raise

    def on_timer(self):
        if self.keyboard is None or not self._call(self._reload):
            return
        if list(self.keyboard.slider_targets) != self.shown:
            self._sync()
        else:
            self._mark_current()
            self._show_flash()

    # ---- lights that flash when switching target ----

    def _flash_available(self):
        kb = self.keyboard
        return kb is not None and bool(getattr(kb, "slider_flash_supported", False)) and \
            bool(getattr(kb, "leds", None))

    def on_layout_changed(self):
        """ (Re)build the flash drawing; only on rebuild and layout option changes. """
        self.flash_section.setVisible(self._flash_available())
        if not self._flash_available():
            return
        choice = self.layout_editor.get_choice if self.layout_editor is not None else None
        self.flash_widget.set_keyboard(self.keyboard.keys, self.keyboard.leds, choice)
        self.flash_shown = None
        self._show_flash()

    def _led_mask(self, wanted):
        return sum(1 << i for i, led in enumerate(self.keyboard.leds[:32]) if wanted(led))

    def _show_flash(self):
        """ Draw the flash mask (the open stroke's, else the keyboard's) in the previewed colour. """
        if not self._flash_available():
            return
        targets = self.keyboard.slider_targets
        idx = self.preview_idx
        if idx is None or idx >= len(targets):
            idx = min(self.keyboard.slider_current, len(targets) - 1)
        colour = tuple(targets[idx].colour) if targets else None
        mask = self.keyboard.slider_flash_mask if self.stroke_mask is None else self.stroke_mask
        colours = [colour if i < 32 and mask & (1 << i) else None for i in range(len(self.keyboard.leds))]
        if colours != self.flash_shown:
            self.flash_shown = colours
            self.flash_widget.set_colours(colours)

    def preview(self, idx):
        self.preview_idx = idx
        self._show_flash()

    def on_flash_painted(self, leds):
        if not self._flash_available():
            return
        leds = [led for led in leds if led < 32]
        if not leds:
            return
        if self.stroke_mask is None:
            self.stroke_mask = self.keyboard.slider_flash_mask
            # the stroke's first light decides whether the whole stroke turns lights on or off
            self.stroke_on = not self.stroke_mask & (1 << leds[0])
        for led in leds:
            if self.stroke_on:
                self.stroke_mask |= 1 << led
            else:
                self.stroke_mask &= ~(1 << led)
        self._show_flash()

    def on_flash_finished(self):
        mask, self.stroke_mask = self.stroke_mask, None
        if mask is not None:
            self._write_flash(mask)

    def _write_flash(self, mask):
        """ Send the mask; the drawing then shows what the keyboard holds. """
        if self._flash_available():
            self._call(self.keyboard.set_slider_flash_mask, mask, write=True)
            self._show_flash()

    # ---- edits ----

    def _targets(self):
        return list(self.keyboard.slider_targets)

    def on_name_edited(self, idx):
        targets = self._targets()
        name = self.rows[idx].name.text()
        if idx >= len(targets) or targets[idx].name == name:
            return
        targets[idx] = targets[idx]._replace(name=name)
        self._write(targets)

    def on_control_changed(self, idx, value):
        targets = self._targets()
        if idx >= len(targets) or targets[idx].control == value:
            return
        targets[idx] = targets[idx]._replace(control=value)
        self._write(targets)

    def on_colour_clicked(self, idx):
        self.dlg_row = idx
        self.dlg_color = QColorDialog()
        self.dlg_color.setModal(True)
        self.dlg_color.finished.connect(self.on_colour_finished)
        self.dlg_color.setCurrentColor(QColor(*self.rows[idx].colour))
        self.dlg_color.show()

    def on_colour_finished(self, result):
        color = self.dlg_color.selectedColor()
        targets = self._targets()
        if result != QDialog.Accepted or not color.isValid() or self.dlg_row >= len(targets):
            return
        targets[self.dlg_row] = targets[self.dlg_row]._replace(colour=(color.red(), color.green(), color.blue()))
        self._write(targets)

    def move(self, idx, delta):
        targets = self._targets()
        other = idx + delta
        if not 0 <= idx < len(targets) or not 0 <= other < len(targets):
            return
        targets[idx], targets[other] = targets[other], targets[idx]
        self._write(targets)

    def remove(self, idx):
        targets = self._targets()
        if len(targets) <= 1 or idx >= len(targets):
            return
        del targets[idx]
        self._write(targets)

    def add(self):
        targets = self._targets()
        if len(targets) >= self.keyboard.slider_max:
            return
        used = {t.control for t in targets}
        candidates = list(range(DEFAULT_CONTROL, ST_MAX_CONTROL + 1)) + list(range(DEFAULT_CONTROL))
        control = next((c for c in candidates if c not in used), DEFAULT_CONTROL)
        targets.append(SliderTarget(control, (255, 255, 255), "Target {}".format(len(targets) + 1)))
        self._write(targets)
# SPDX-License-Identifier: GPL-2.0-or-later
from PyQt5 import QtCore
from PyQt5.QtCore import Qt, pyqtSignal, QObject
from PyQt5.QtWidgets import QWidget, QSizePolicy, QGridLayout, QHBoxLayout, QVBoxLayout, QLabel, QCheckBox, QScrollArea, QFrame, QToolButton

from protocol.constants import VIAL_PROTOCOL_DYNAMIC
from util import make_scrollable, tr
from widgets.key_widget import KeyWidget
from protocol.alt_repeat_key import AltRepeatKeyOptions, AltRepeatKeyEntry
from vial_device import VialKeyboard
from editor.basic_editor import BasicEditor
from widgets.checkbox_no_padding import CheckBoxNoPadding
from widgets.tab_widget_keycodes import TabWidgetWithKeycodes


class ModsUI(QWidget):

    changed = pyqtSignal()

    def __init__(self):
        super().__init__()

        self.mods = [
            CheckBoxNoPadding("LCtrl"),
            CheckBoxNoPadding("LShift"),
            CheckBoxNoPadding("LAlt"),
            CheckBoxNoPadding("LGui"),
            CheckBoxNoPadding("RCtrl"),
            CheckBoxNoPadding("RShift"),
            CheckBoxNoPadding("RAlt"),
            CheckBoxNoPadding("RGui"),
        ]

        for w in self.mods:
            w.stateChanged.connect(self.on_change)

        container = QGridLayout()
        container.addWidget(self.mods[0], 0, 0)
        container.addWidget(self.mods[4], 1, 0)

        container.addWidget(self.mods[1], 0, 1)
        container.addWidget(self.mods[5], 1, 1)

        container.addWidget(self.mods[2], 0, 2)
        container.addWidget(self.mods[6], 1, 2)

        container.addWidget(self.mods[3], 0, 3)
        container.addWidget(self.mods[7], 1, 3)

        self.setLayout(container)

    def load(self, data):
        for x, chk in enumerate(self.mods):
            chk.setChecked(bool(data & (1 << x)))

    def save(self):
        out = 0
        for x, chk in enumerate(self.mods):
            out |= int(chk.isChecked()) << x
        return out

    def on_change(self):
        self.changed.emit()


class OptionsUI(QWidget):

    changed = pyqtSignal()

    def __init__(self):
        super().__init__()

        container = QVBoxLayout()

        self.opt_default_to_this_alt_key = CheckBoxNoPadding("Default to this alt key")
        self.opt_bidirectional = CheckBoxNoPadding("Bidirectional")
        self.opt_ignore_mod_handedness = CheckBoxNoPadding("Ignore mod handedness")

        for w in [self.opt_default_to_this_alt_key, self.opt_bidirectional,
                  self.opt_ignore_mod_handedness]:
            w.stateChanged.connect(self.on_change)
            container.addWidget(w)

        self.setLayout(container)

    def on_change(self):
        self.changed.emit()

    def load(self, opt: AltRepeatKeyOptions):
        self.opt_default_to_this_alt_key.setChecked(opt.default_to_this_alt_key)
        self.opt_bidirectional.setChecked(opt.bidirectional)
        self.opt_ignore_mod_handedness.setChecked(opt.ignore_mod_handedness)

    def save(self) -> AltRepeatKeyOptions:
        opts = AltRepeatKeyOptions()
        opts.default_to_this_alt_key = self.opt_default_to_this_alt_key.isChecked()
        opts.bidirectional = self.opt_bidirectional.isChecked()
        opts.ignore_mod_handedness = self.opt_ignore_mod_handedness.isChecked()
        return opts


class AltRepeatKeyEntryUI(QObject):

    changed = pyqtSignal()

    def __init__(self, idx):
        super().__init__()

        self.enable_chk = QCheckBox()
        self.last_key = KeyWidget()
        self.alt_key = KeyWidget()
        self.allowed_mods = ModsUI()
        self.options = OptionsUI()

        self.widgets = [self.enable_chk]
        self.enable_chk.stateChanged.connect(self.on_change)
        for w in [self.options, self.last_key, self.alt_key, self.allowed_mods]:
            w.changed.connect(self.on_change)
            self.widgets.append(w)

        self.idx = idx
        self.container = QGridLayout()
        self.populate_container()

        w = QWidget()
        w.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Maximum)
        w.setLayout(self.container)
        l = QVBoxLayout()
        l.addWidget(w)
        l.setAlignment(w, QtCore.Qt.AlignHCenter)
        self.w2 = make_scrollable(l)

    def populate_container(self):
        self.container.addWidget(QLabel("Enable"), 0, 0)
        self.container.addWidget(self.enable_chk, 0, 1)

        self.container.addWidget(QLabel("Last key"), 2, 0)
        self.container.addWidget(self.last_key, 2, 1)

        self.container.addWidget(QLabel("Alt key"), 3, 0)
        self.container.addWidget(self.alt_key, 3, 1)

        self.container.addWidget(QLabel("Allowed mods"), 4, 0)
        self.container.addWidget(self.allowed_mods, 4, 1)

        self.container.addWidget(QLabel("Options"), 5, 0)
        self.container.addWidget(self.options, 5, 1)

    def widget(self):
        return self.w2

    def load(self, arep):
        for w in self.widgets:
            w.blockSignals(True)

        self.enable_chk.setChecked(arep.options.enabled)
        self.last_key.set_keycode(arep.keycode)
        self.alt_key.set_keycode(arep.alt_keycode)
        self.allowed_mods.load(arep.allowed_mods)
        self.options.load(arep.options)

        for w in self.widgets:
            w.blockSignals(False)

    def save(self):
        arep = AltRepeatKeyEntry()
        arep.options = self.options.save()
        arep.options.enabled = self.enable_chk.isChecked()
        arep.keycode = self.last_key.keycode
        arep.alt_keycode = self.alt_key.keycode
        arep.allowed_mods = self.allowed_mods.save()
        return arep

    def on_change(self):
        self.changed.emit()


class AltRepeatKey(BasicEditor):

    def __init__(self):
        super().__init__()
        self.keyboard = None

        self.alt_repeat_key_entries = []
        self.alt_repeat_key_entries_available = []
        self.tabs = TabWidgetWithKeycodes()
        for x in range(128):
            entry = AltRepeatKeyEntryUI(x)
            entry.changed.connect(self.on_change)
            self.alt_repeat_key_entries_available.append(entry)

        self.addWidget(self.tabs)

    def rebuild_ui(self):
        while self.tabs.count() > 0:
            self.tabs.removeTab(0)
        self.alt_repeat_key_entries = self.alt_repeat_key_entries_available[:self.keyboard.alt_repeat_key_count]
        for x, e in enumerate(self.alt_repeat_key_entries):
            self.tabs.addTab(e.widget(), str(x + 1))
        for x, e in enumerate(self.alt_repeat_key_entries):
            e.load(self.keyboard.alt_repeat_key_get(x))

    def rebuild(self, device):
        super().rebuild(device)
        if self.valid():
            self.keyboard = device.keyboard
            self.rebuild_ui()

    def valid(self):
        return isinstance(self.device, VialKeyboard) and \
               (self.device.keyboard and self.device.keyboard.vial_protocol >= VIAL_PROTOCOL_DYNAMIC
                and self.device.keyboard.alt_repeat_key_count > 0)

    def on_change(self):
        for x, e in enumerate(self.alt_repeat_key_entries):
            self.keyboard.alt_repeat_key_set(x, self.alt_repeat_key_entries[x].save())
# SPDX-License-Identifier: GPL-2.0-or-later
import logging

from PyQt5.QtCore import Qt, QTimer, pyqtSignal
from PyQt5.QtGui import QColor
from PyQt5.QtWidgets import QHBoxLayout, QLabel, QPushButton, QWidget, QButtonGroup, QColorDialog, QSizePolicy

from editor.basic_editor import BasicEditor
from editor.key_colours_history import ColourHistory
from util import tr
from vial_device import VialKeyboard
from widgets.clickable_label import ClickableLabel
from widgets.colour_keyboard_widget import ColourKeyboardWidget

SWATCHES = [
    ("Orange", "#ff4200"),
    ("Pink", "#fa59ff"),
    ("Purple", "#8a2be2"),
    ("Ice blue", "#7fd4ff"),
    ("Green", "#00c853"),
    ("Red", "#ff1744"),
    ("Yellow", "#ffd600"),
    ("White", "#ffffff"),
    ("Off", "#000000"),
]

BANNER_TEXT = "Your key colours were reset, usually by a firmware update. " \
              "Load your saved layout file to bring them back."

TOOLS = [("brush", "Brush"), ("fill", "Fill"), ("eraser", "Eraser")]

PREVIEW_INTERVAL_MS = 1000


def _swatch_style(name):
    return "QLabel { background-color: %s; border: 1px solid palette(button-text); }" % name


def _rgb(name):
    c = QColor(name)
    return (c.red(), c.green(), c.blue())


class KeyColoursEditor(BasicEditor):
    """ Paint per-layer key colours: pick a colour, then brush it onto keys. """

    save_requested = pyqtSignal()
    load_requested = pyqtSignal()

    def __init__(self, layout_editor):
        super().__init__()
        self.layout_editor = layout_editor
        self.keyboard = None
        self.layer = 0
        self.tool = "brush"
        self.brush_colour = _rgb(SWATCHES[0][1])
        self.history = ColourHistory()
        self.active = False
        self.in_stroke = False
        self.dlg_color = None
        self.write_error = False   # error label shows a failed write

        self.preview_timer = QTimer()
        self.preview_timer.setInterval(PREVIEW_INTERVAL_MS)
        self.preview_timer.timeout.connect(self.on_preview_timer)

        self._build_banner()

        self.error_label = QLabel()
        self.error_label.setStyleSheet("QLabel { color: #d32f2f; }")
        self.error_label.setWordWrap(True)
        self.error_label.hide()
        self.addWidget(self.error_label)

        self.layout_layers = QHBoxLayout()
        self.layer_group = QButtonGroup()
        self.layer_group.setExclusive(True)
        self.layer_buttons = []
        self.addLayout(self.layout_layers)

        self._build_tools()

        self.addStretch()
        self.widget = ColourKeyboardWidget()
        self.widget.stroke_painted.connect(self.on_stroke_painted)
        self.widget.stroke_finished.connect(self.on_stroke_finished)
        self.addWidget(self.widget)
        self.setAlignment(self.widget, Qt.AlignHCenter)
        self.addStretch()

        self._build_files()

        layout_editor.changed.connect(self.on_layout_changed)

    # ---- UI construction ----

    def _build_banner(self):
        self.banner = QWidget()
        row = QHBoxLayout()
        row.setContentsMargins(0, 0, 0, 0)
        self.banner_label = QLabel(tr("KeyColours", BANNER_TEXT))
        self.banner_label.setWordWrap(True)
        row.addWidget(self.banner_label, 1)
        self.btn_banner_load = QPushButton(tr("KeyColours", "Load"))
        self.btn_banner_load.clicked.connect(self.load_requested.emit)
        row.addWidget(self.btn_banner_load)
        self.banner.setLayout(row)
        self.banner.hide()
        self.addWidget(self.banner)

    def _build_tools(self):
        row = QHBoxLayout()
        self.tool_group = QButtonGroup()
        self.tool_group.setExclusive(True)
        self.tool_buttons = {}
        for name, label in TOOLS:
            btn = QPushButton(tr("KeyColours", label))
            btn.setCheckable(True)
            btn.setFocusPolicy(Qt.NoFocus)
            btn.clicked.connect(lambda state, n=name: self.set_tool(n))
            self.tool_group.addButton(btn)
            self.tool_buttons[name] = btn
            row.addWidget(btn)
        self.tool_buttons[self.tool].setChecked(True)

        row.addSpacing(16)
        row.addWidget(QLabel(tr("KeyColours", "Colour:")))
        self.current_swatch = QLabel(" ")
        self.current_swatch.setMinimumWidth(32)
        row.addWidget(self.current_swatch)

        for name, value in SWATCHES:
            sw = ClickableLabel(" ")
            sw.setToolTip(tr("KeyColours", name))
            sw.setMinimumWidth(24)
            sw.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Preferred)
            sw.setStyleSheet(_swatch_style(value))
            sw.clicked.connect(lambda v=value: self.set_brush_colour(_rgb(v)))
            row.addWidget(sw)

        btn_any = QPushButton(tr("KeyColours", "Any colour"))
        btn_any.clicked.connect(self.on_any_colour)
        row.addWidget(btn_any)

        row.addStretch()
        self.btn_undo = QPushButton(tr("KeyColours", "Undo"))
        self.btn_undo.clicked.connect(self.on_undo)
        self.btn_undo.setEnabled(False)
        row.addWidget(self.btn_undo)
        self.addLayout(row)
        self._show_brush_colour()

    def _build_files(self):
        row = QHBoxLayout()
        row.addStretch()
        self.btn_save = QPushButton(tr("KeyColours", "Save backupâ€¦"))
        self.btn_save.clicked.connect(self.save_requested.emit)
        row.addWidget(self.btn_save)
        self.btn_load = QPushButton(tr("KeyColours", "Load backupâ€¦"))
        self.btn_load.clicked.connect(self.load_requested.emit)
        row.addWidget(self.btn_load)
        self.addLayout(row)

    def _rebuild_layer_buttons(self):
        for btn in self.layer_buttons:
            self.layer_group.removeButton(btn)
            btn.hide()
            btn.deleteLater()
        self.layer_buttons = []
        for x in range(self.keyboard.key_colours_layers):
            btn = QPushButton(tr("KeyColours", "Layer {}").format(x))
            btn.setCheckable(True)
            btn.setFocusPolicy(Qt.NoFocus)
            btn.clicked.connect(lambda state, idx=x: self.set_layer(idx))
            self.layer_group.addButton(btn)
            self.layout_layers.addWidget(btn)
            self.layer_buttons.append(btn)

    # ---- BasicEditor ----

    def valid(self):
        return isinstance(self.device, VialKeyboard) and bool(self.device.keyboard.key_colours_supported)

    def rebuild(self, device):
        super().rebuild(device)
        self.history = ColourHistory()
        self.in_stroke = False
        self.write_error = False
        self.error_label.hide()
        if not self.valid():
            self.keyboard = None
            self.preview_timer.stop()
            return
        self.keyboard = device.keyboard
        if self.layer >= self.keyboard.key_colours_layers:
            self.layer = 0
        self._rebuild_layer_buttons()
        self.on_layout_changed()
        self.set_layer(self.layer)

    def activate(self):
        self.active = True
        if self.valid():
            self._send_preview()
            self.preview_timer.start()

    def deactivate(self):
        self.active = False
        self.preview_timer.stop()
        if self.valid():
            self._call(self.keyboard.set_key_colours_preview, None)

    # ---- state ----

    def on_layout_changed(self):
        if self.keyboard is None:
            return
        self.widget.set_keyboard(self.keyboard.keys, self.keyboard.leds, self.layout_editor.get_choice)
        self.refresh()

    def set_layer(self, layer):
        self.layer = layer
        if layer < len(self.layer_buttons):
            self.layer_buttons[layer].setChecked(True)
        self.refresh()
        if self.active:
            self._send_preview()

    def set_tool(self, tool):
        self.tool = tool
        self.tool_buttons[tool].setChecked(True)

    def set_brush_colour(self, colour):
        self.brush_colour = tuple(colour)
        if self.tool == "eraser":
            self.set_tool("brush")
        self._show_brush_colour()

    def _show_brush_colour(self):
        self.current_swatch.setStyleSheet(_swatch_style(QColor(*self.brush_colour).name()))

    def refresh(self):
        self.btn_undo.setEnabled(self.history.can_undo())
        if self.keyboard is None:
            return
        self.widget.set_colours(self.keyboard.key_colours[self.layer])
        self.banner.setVisible(not self.keyboard.key_colours_initialised)

    # ---- keyboard I/O ----

    def _call(self, fn, *args, write=False):
        """ Run a keyboard call; on failure show the error inline instead of crashing.
        A failed write stays shown until the next successful write; previews never clear it. """
        try:
            fn(*args)
        except Exception as e:
            logging.warning("key colours: %s", e)
            self.error_label.setText(tr("KeyColours", "Could not talk to the keyboard: {}").format(e))
            self.error_label.show()
            self.write_error = self.write_error or write
            return False
        if write or not self.write_error:
            self.error_label.hide()
            self.write_error = False
        return True

    def _send_preview(self):
        self._call(self.keyboard.set_key_colours_preview, self.layer)

    def on_preview_timer(self):
        if self.active and self.valid():
            self._send_preview()

    def _apply(self, leds):
        """ Paint leds on the current layer with the current tool, as part of the open stroke. """
        new = None if self.tool == "eraser" else self.brush_colour
        row = self.keyboard.key_colours[self.layer]
        changes = {}
        for led in leds:
            old = row[led]
            if old != new:
                self.history.record(led, old, new)
                changes[led] = new
        if changes:
            self._call(self.keyboard.set_key_colours, self.layer, changes, write=True)
        self.refresh()

    # ---- painting ----

    def on_stroke_painted(self, leds):
        if self.keyboard is None:
            return
        if self.tool == "fill":
            if self.in_stroke:
                return
            leds = range(len(self.keyboard.key_colours[self.layer]))
        if not self.in_stroke:
            self.history.begin_stroke(self.layer)
            self.in_stroke = True
        self._apply(leds)

    def on_stroke_finished(self):
        if self.in_stroke:
            self.history.end_stroke()
            self.in_stroke = False
        self.refresh()

    def on_undo(self):
        if self.keyboard is None or self.in_stroke:
            return
        entry = self.history.undo()
        if entry is None:
            return
        layer, olds = entry
        if not self._call(self.keyboard.set_key_colours, layer, olds, write=True):
            # keep it so the user can retry once the keyboard answers again
            self.history.stack.append(entry)
        self.set_layer(layer)

    def on_any_colour(self):
        self.dlg_color = QColorDialog()
        self.dlg_color.setModal(True)
        self.dlg_color.finished.connect(self.on_any_colour_finished)
        self.dlg_color.setCurrentColor(QColor(*self.brush_colour))
        self.dlg_color.show()

    def on_any_colour_finished(self):
        color = self.dlg_color.selectedColor()
        if color.isValid():
            self.set_brush_colour((color.red(), color.green(), color.blue()))
